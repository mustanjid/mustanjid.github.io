---
// Giscus comments (GitHub Discussions), one thread per page: giscus matches the discussion by the page URL, so every
// post, project, paper, moment and award page gets its own thread automatically. The Giscus loader is injected from code instead of being a static script element
// because Astro View Transitions run a normal script only once per full load: opening a second post by clicking a
// link would otherwise show no comment box.
---

<section id="comments" aria-label="Comments" class="mx-auto mt-10 w-full">
  <div class="giscus" data-giscus-host></div>
</section>

<script>
  const GISCUS_ORIGIN = "https://giscus.app";
  const isDark = () => document.documentElement.classList.contains("dark");

  const mountComments = () => {
    const host = document.querySelector<HTMLElement>("[data-giscus-host]");
    if (!host || host.childElementCount > 0) return;

    const script = document.createElement("script");
    script.src = `${GISCUS_ORIGIN}/client.js`;
    script.async = true;
    script.crossOrigin = "anonymous";
    const attributes: Record<string, string> = {
      "data-repo": "mustanjid/mustanjid.github.io",
      "data-repo-id": "R_kgDOK_PBjQ",
      "data-category": "General",
      "data-category-id": "DIC_kwDOK_PBjc4CcWCI",
      "data-mapping": "url",
      "data-strict": "0",
      "data-reactions-enabled": "1",
      "data-emit-metadata": "0",
      "data-input-position": "bottom",
      "data-theme": isDark() ? "dark" : "light",
      "data-lang": "en",
    };
    Object.entries(attributes).forEach(([name, value]) =>
      script.setAttribute(name, value),
    );
    host.appendChild(script);
  };

  // The site's own light/dark toggle changes the <html> class; keep the comment box in step with it.
  const syncTheme = () => {
    const frame = document.querySelector<HTMLIFrameElement>(
      "iframe.giscus-frame",
    );
    frame?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: isDark() ? "dark" : "light" } } },
      GISCUS_ORIGIN,
    );
  };

  document.addEventListener("astro:page-load", mountComments);
  new MutationObserver(syncTheme).observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["class"],
  });
  mountComments();
</script>
