---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import { siteData } from "@/data/content";
import { settings } from "@/data/settings";

const author = await getEntry("authors", "default");
const intro = await getEntry("home", "intro");
const { Content } = intro ? await intro.render() : { Content: null };
const tagline = intro?.data.tagline ?? [];
const name = author?.data.name ?? "";
const avatar = author?.data.avatar;
const { greeting } = settings;
// Short intro text is set large; longer text is set at a moderate size so the card stays balanced.
const introSize = (intro?.body?.length ?? 0) < 400 ? "c2-lead-lg" : "c2-lead-md";
// Labelled buttons for GitHub / LinkedIn, taken from the Social links in /admin.
const profileButtons = siteData.socialLinks
  .filter(({ kind }) => kind === "github" || kind === "linkedin")
  .map(({ kind, url }) => ({ label: kind === "github" ? "GitHub" : "LinkedIn", href: url }));
---

<section class="c2-card flex h-full flex-col justify-between gap-6 p-6 sm:p-8" aria-labelledby="home-title">
  <div>
    <div class="flex items-center gap-4">
      {avatar && (
        <Image src={avatar} alt={`Portrait of ${name}`} width={72} height={72} loading="eager" class="h-[72px] w-[72px] shrink-0 rounded-[20px] border border-[var(--c2-line-strong)] object-cover" />
      )}
      <div class="flex flex-col gap-0.5">
        <p class="m-0 font-mono text-[15px] text-[var(--c2-soft)]">{greeting}</p>
        <p class="m-0 text-sm text-[var(--c2-soft)]">
          <b class="font-semibold text-[var(--c2-fg)]">{name}</b>{tagline.length > 0 && <> · {tagline.join(" · ")}</>}
        </p>
      </div>
    </div>

    <h1 id="home-title" class="c2-title mt-6 mb-0 text-4xl leading-[1.1] sm:text-5xl">
      I'm <span class="c2-grad">{name}</span>.
    </h1>

    {Content && (
      <div class:list={["c2-lead mt-5 text-justify", introSize]}>
        <Content />
      </div>
    )}
  </div>

  <div class="flex flex-wrap items-center gap-3">
    <a href="/blog" class="cta-primary">My thoughts</a>
    {profileButtons.map(({ label, href }) => (
      <a href={href} class="cta-outline" target="_blank" rel="noopener noreferrer">{label}</a>
    ))}
    <a href="/cv" class="cta-outline">View CV</a>
  </div>
</section>
