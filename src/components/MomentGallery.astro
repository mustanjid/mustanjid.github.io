---
// Photo slider for one moment: swipe (or use the dots/arrows) to move between photos.
//  - variant "card":   cropped photos on the Moments list; tapping a photo opens the full-size viewer
//  - variant "detail": whole photos with each photo's own description underneath (details page)

interface Props {
  photos: { image: string; description?: string }[];
  /** Fallback alt text / accessible name, e.g. the moment's title. */
  title: string;
  variant?: "card" | "detail";
}

const { photos, title, variant = "card" } = Astro.props;
const isDetail = variant === "detail";
const total = photos.length;
const arrow = "absolute z-10 flex h-10 w-10 items-center justify-center rounded-full bg-black/55 text-2xl leading-none text-white hover:bg-black/75 focus:outline-none focus:ring-2 focus:ring-white";
---

<div data-moment-gallery={variant} class:list={["relative w-full", isDetail && "overflow-hidden rounded-2xl bg-slate-900 pb-3 shadow-xl"]}>
  <ul
    data-moment-track
    class:list={["flex snap-x snap-mandatory overflow-x-auto scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden", !isDetail && "rounded-lg bg-gray-100 dark:bg-gray-800"]}
  >
    {photos.map(({ image, description }, index) => {
      const alt = description || title;
      return (
        <li class:list={["w-full shrink-0 snap-center", isDetail && "relative overflow-hidden"]} data-moment-slide>
          {isDetail ? (
            <>
              {/* soft blurred copy of the photo glows behind it, so the stage picks up each photo's colours */}
              <img src={image} alt="" aria-hidden="true" class="pointer-events-none absolute inset-0 h-full w-full scale-125 object-cover opacity-40 blur-2xl" loading="lazy" decoding="async" />
              <figure class="relative">
                <img src={image} alt={alt} class="h-72 w-full object-contain sm:h-[26rem]" loading={index === 0 ? "eager" : "lazy"} decoding="async" />
                {description && (
                  <figcaption class="whitespace-pre-line px-5 pb-4 pt-3 text-center text-sm leading-6 text-white/90 [text-shadow:0_1px_6px_rgb(0_0_0/0.5)]">{description}</figcaption>
                )}
              </figure>
            </>
          ) : (
            <button
              type="button"
              data-moment-open
              data-index={index}
              data-image-src={image}
              data-image-alt={alt}
              data-image-desc={description ?? ""}
              aria-label={`View photo ${index + 1} of ${total} full size: ${title}`}
              class="group block w-full focus:outline-none focus-visible:ring-2 focus-visible:ring-primary-500"
            >
              <img src={image} alt={alt} class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.02]" loading="lazy" decoding="async" />
            </button>
          )}
        </li>
      );
    })}
  </ul>

  {total > 1 && (
    <>
      <span data-moment-count aria-hidden="true" class="pointer-events-none absolute right-2 top-2 rounded-full bg-black/60 px-2.5 py-1 text-xs font-semibold text-white">1 / {total}</span>
      {isDetail && (
        <>
          <button type="button" data-moment-prev aria-label="Previous photo" class:list={[arrow, "left-2 top-36 -translate-y-1/2 sm:top-52"]}><span aria-hidden="true">&#8249;</span></button>
          <button type="button" data-moment-next aria-label="Next photo" class:list={[arrow, "right-2 top-36 -translate-y-1/2 sm:top-52"]}><span aria-hidden="true">&#8250;</span></button>
        </>
      )}
      <div class="mt-3 flex justify-center gap-2" role="group" aria-label={`Photos: ${title}`}>
        {photos.map((_, index) => (
          <button
            type="button"
            data-moment-dot
            data-index={index}
            aria-label={`Show photo ${index + 1} of ${total}`}
            aria-current={index === 0 ? "true" : "false"}
            class:list={["h-2.5 rounded-full transition-all", isDetail ? (index === 0 ? "w-6 bg-white" : "w-2.5 bg-white/35 hover:bg-white/60") : (index === 0 ? "w-6 bg-primary-600" : "w-2.5 bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-500")]}
          />
        ))}
      </div>
    </>
  )}
</div>

<script>
  // Delegated listeners so the sliders keep working after Astro View Transitions swap the page body.
  const w = window as unknown as { __momentGalleryReady?: boolean };
  const dotBase = "h-2.5 rounded-full transition-all";
  const dotActive = `${dotBase} w-6 bg-primary-600`;
  const dotIdle = `${dotBase} w-2.5 bg-gray-300 hover:bg-gray-400 dark:bg-gray-600 dark:hover:bg-gray-500`;
  // on the dark details-page stage the dots are white instead of the site colour
  const stageDotActive = `${dotBase} w-6 bg-white`;
  const stageDotIdle = `${dotBase} w-2.5 bg-white/35 hover:bg-white/60`;

  const trackOf = (el: Element) => el.closest<HTMLElement>("[data-moment-gallery]")?.querySelector<HTMLElement>("[data-moment-track]") ?? null;
  const currentIndex = (track: HTMLElement) => (track.clientWidth ? Math.round(track.scrollLeft / track.clientWidth) : 0);
  const slideCount = (track: HTMLElement) => track.querySelectorAll("[data-moment-slide]").length;

  const goToSlide = (track: HTMLElement, index: number) => {
    const left = index * track.clientWidth;
    if (typeof track.scrollTo === "function") track.scrollTo({ left, behavior: "smooth" });
    else track.scrollLeft = left;
  };

  // Keep the dots and the "2 / 5" counter in step with the photo currently in view.
  const syncGallery = (gallery: HTMLElement, index: number) => {
    const onStage = gallery.dataset.momentGallery === "detail";
    gallery.querySelectorAll<HTMLElement>("[data-moment-dot]").forEach((dot, i) => {
      dot.className = i === index ? (onStage ? stageDotActive : dotActive) : onStage ? stageDotIdle : dotIdle;
      dot.setAttribute("aria-current", String(i === index));
    });
    const count = gallery.querySelector<HTMLElement>("[data-moment-count]");
    if (count) count.textContent = `${index + 1} / ${gallery.querySelectorAll("[data-moment-slide]").length}`;
  };

  if (!w.__momentGalleryReady) {
    w.__momentGalleryReady = true;

    document.addEventListener("click", (event) => {
      const target = event.target as Element;

      const dot = target.closest<HTMLButtonElement>("[data-moment-dot]");
      if (dot) {
        const track = trackOf(dot);
        if (track) goToSlide(track, Number(dot.dataset.index ?? 0));
        return;
      }

      const step = target.closest("[data-moment-prev]") ? -1 : target.closest("[data-moment-next]") ? 1 : 0;
      if (step) {
        const track = trackOf(target);
        if (!track) return;
        const total = slideCount(track);
        goToSlide(track, (currentIndex(track) + step + total) % total); // wraps around
      }
    });

    // scroll events do not bubble, so listen in the capture phase
    document.addEventListener(
      "scroll",
      (event) => {
        const track = event.target instanceof HTMLElement ? event.target.closest<HTMLElement>("[data-moment-track]") : null;
        const gallery = track?.closest<HTMLElement>("[data-moment-gallery]");
        if (!track || !gallery || track.clientWidth === 0) return;
        syncGallery(gallery, currentIndex(track));
      },
      true,
    );
  }
</script>
