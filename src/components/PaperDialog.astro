---
// "Details" modal for one research paper. Render it anywhere a paper is shown (research cards, project pages...) and
// give any button `data-paper-open={`details-${entry.slug}`}` to open it. The click handling at the bottom is
// delegated, so it keeps working after Astro View Transitions swap the page body.
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { STATUS_LABEL, doiUrl, paperCitation, paperPdfUrl } from "@/research-ui";

interface Props {
  entry: CollectionEntry<"research">;
}

const { entry } = Astro.props;
const { data, slug } = entry;
const dialogId = `details-${slug}`;
const citation = paperCitation(data);
const pdfLink = paperPdfUrl(data.pdfUrl, data.url, data.preprintUrl);
const doiLink = doiUrl(data.doi);
const buttonClass = "inline-flex min-h-9 items-center rounded-full border border-white/60 px-4 py-1.5 text-xs font-semibold text-white hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white";
const term = "font-semibold text-white/60";
---

<dialog id={dialogId} data-paper-dialog aria-labelledby={`${dialogId}-title`} class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none overflow-y-auto bg-transparent p-0 text-left text-white backdrop:bg-black/65 backdrop:backdrop-blur-xl">
  <!-- Open view: the details sit directly on the blurred page, no card. Click outside the column to close. -->
  <div class="mx-auto min-h-full max-w-3xl px-4 py-6 sm:py-10">
    <div class="flex items-start justify-between gap-4 [text-shadow:0_1px_8px_rgb(0_0_0/0.6)]">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wide text-primary-200">{STATUS_LABEL[data.status]}</p>
        <h3 id={`${dialogId}-title`} class="mt-1 text-xl font-bold leading-7 text-white">{data.title}</h3>
      </div>
      <button type="button" data-paper-close class="shrink-0 rounded-full bg-white/15 px-4 py-2 text-sm font-semibold text-white backdrop-blur hover:bg-white/25 focus:outline-none focus:ring-2 focus:ring-white">Close</button>
    </div>
    <div class="mt-5 space-y-5 [text-shadow:0_1px_6px_rgb(0_0_0/0.45)]">
      {data.image && (
        <figure>
          <button type="button" data-image-viewer={data.image} data-image-alt={`Image for ${data.title}`} class="group block w-full cursor-zoom-in focus:outline-none focus:ring-2 focus:ring-white" aria-label={`View full-size image for ${data.title}`}>
            <img src={data.image} alt={`Image for ${data.title}`} class="max-h-[58vh] w-full rounded-lg bg-white object-contain shadow-2xl" loading="lazy" />
          </button>
          <figcaption class="mt-1.5 text-center text-xs text-white/70">Select the image to view it full size</figcaption>
        </figure>
      )}
      <p class="text-sm leading-6 text-white/90">{citation}</p>
      <dl class="grid gap-x-4 gap-y-2 text-sm sm:grid-cols-[8rem_minmax(0,1fr)]">
        <dt class={term}>Authors</dt>
        <dd class="text-white/90">{data.authors}</dd>
        {data.venue && <><dt class={term}>Journal / venue</dt><dd class="text-white/90">{data.venue}</dd></>}
        {data.publisher && <><dt class={term}>Publisher</dt><dd class="text-white/90">{data.publisher}</dd></>}
        {data.date && <><dt class={term}>Date</dt><dd class="text-white/90"><FormattedDate date={data.date} /></dd></>}
        {data.citationDetails && <><dt class={term}>Publication</dt><dd class="text-white/90">{data.citationDetails}</dd></>}
        {data.doi && <><dt class={term}>DOI</dt><dd class="text-white/90">{data.doi}</dd></>}
      </dl>
      <section>
        <h4 class="text-sm font-semibold text-white">Description</h4>
        <p class="mt-1 whitespace-pre-line text-sm leading-6 text-white/90">{data.summary?.trim() || "No description has been added yet."}</p>
      </section>
      <div class="flex flex-wrap gap-2">
        {pdfLink && <a class={buttonClass} href={pdfLink} target="_blank" rel="noopener noreferrer">PDF</a>}
        {data.datasetUrl && <a class={buttonClass} href={data.datasetUrl} target="_blank" rel="noopener noreferrer">Dataset</a>}
        {data.projectUrl && <a class={buttonClass} href={data.projectUrl} target="_blank" rel="noopener noreferrer">Project</a>}
        {data.codeUrl && <a class={buttonClass} href={data.codeUrl} target="_blank" rel="noopener noreferrer">Code</a>}
        {doiLink && <a class={buttonClass} href={doiLink} target="_blank" rel="noopener noreferrer">DOI</a>}
      </div>
    </div>
  </div>
</dialog>

<script>
  // Delegated listeners. With Astro View Transitions this module script runs once per full page load, but the
  // page body is replaced on every client-side navigation (menu -> Research on a phone, project -> paper link...).
  // Listeners attached to the buttons themselves are lost then, which made "Details" do nothing.
  const w = window as unknown as { __publicationUiReady?: boolean };

  const copyText = async (text: string): Promise<boolean> => {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      const area = document.createElement("textarea");
      area.value = text;
      area.setAttribute("readonly", "");
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.appendChild(area);
      area.select();
      const ok = document.execCommand("copy");
      area.remove();
      return ok;
    }
  };

  // One full-size image viewer for the whole page, built the first time it is needed.
  const openViewer = (src: string, alt: string) => {
    if (!src) return;
    let viewer = document.getElementById("image-viewer") as HTMLDialogElement | null;
    if (!viewer) {
      viewer = document.createElement("dialog");
      viewer.id = "image-viewer";
      viewer.setAttribute("aria-label", "Full-size image");
      viewer.className = "fixed inset-0 m-0 h-full max-h-none w-full max-w-none overflow-hidden bg-transparent p-0 backdrop:bg-black/70 backdrop:backdrop-blur-xl";
      viewer.innerHTML =
        '<div class="flex h-full w-full cursor-zoom-out items-center justify-center p-3 sm:p-8"><img data-viewer-image alt="" class="max-h-full max-w-full rounded-lg bg-white object-contain shadow-2xl" /></div>' +
        '<button type="button" class="absolute right-3 top-3 rounded-full bg-white/15 px-4 py-2 text-sm font-semibold text-white backdrop-blur hover:bg-white/25 focus:outline-none focus:ring-2 focus:ring-white sm:right-6 sm:top-6">Close</button>';
      document.body.appendChild(viewer);
    }
    const image = viewer.querySelector<HTMLImageElement>("[data-viewer-image]");
    if (image) {
      image.src = src;
      image.alt = alt;
    }
    if (!viewer.open) viewer.showModal();
  };

  if (!w.__publicationUiReady) {
    w.__publicationUiReady = true;

    document.addEventListener("click", async (event) => {
      const target = event.target as Element;

      const citeButton = target.closest<HTMLButtonElement>("[data-cite-copy]");
      if (citeButton) {
        const status = citeButton.closest("article")?.querySelector<HTMLElement>("[data-cite-status]");
        const copied = await copyText(citeButton.dataset.citeCopy ?? "");
        if (status) {
          status.textContent = copied ? "Citation copied." : "Could not copy citation. Open Details to copy it manually.";
          window.setTimeout(() => (status.textContent = ""), 3000);
        }
        return;
      }

      const openButton = target.closest<HTMLButtonElement>("[data-paper-open]");
      if (openButton) {
        const dialog = document.getElementById(openButton.dataset.paperOpen ?? "") as HTMLDialogElement | null;
        if (dialog && !dialog.open) dialog.showModal();
        return;
      }

      const viewerButton = target.closest<HTMLElement>("[data-image-viewer]");
      if (viewerButton) {
        openViewer(viewerButton.dataset.imageViewer ?? "", viewerButton.dataset.imageAlt ?? "");
        return;
      }

      const viewer = target.closest<HTMLDialogElement>("#image-viewer");
      if (viewer) {
        viewer.close(); // anywhere on the viewer (photo, empty space or the Close button) closes it
        return;
      }

      if (target.closest("[data-paper-close]")) {
        target.closest("dialog")?.close();
        return;
      }

      // A click on the dimmed backdrop lands on the <dialog> element itself.
      if (target instanceof HTMLDialogElement && target.hasAttribute("data-paper-dialog")) target.close();
    });
  }
</script>
