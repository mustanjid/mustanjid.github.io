---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { STATUS_BADGE, STATUS_LABEL, doiUrl, paperPdfUrl } from "@/research-ui";

interface Props {
  entry: CollectionEntry<"research">;
}

const { entry } = Astro.props;
const { data, slug } = entry;
const citation = data.citation?.trim() || [
  `${data.authors}${data.date ? ` (${data.date.getFullYear()})` : ""}.`,
  `${data.title}.`,
  data.venue,
  data.citationDetails,
].filter(Boolean).join(" ");
const pdfLink = paperPdfUrl(data.pdfUrl, data.url, data.preprintUrl);
const doiLink = doiUrl(data.doi);
const publicationDate = data.date
  ? `${data.date.toLocaleDateString("en-US", { month: "long" })}, ${data.date.getFullYear()}`
  : undefined;
const publicationType = data.publicationType === "conference"
  ? "Conference"
  : data.publicationType === "thesis"
    ? "Thesis"
    : "Journal";
const dialogId = `details-${slug}`;
const buttonClass = "inline-flex min-h-9 items-center rounded-md border border-primary-700 px-3 py-1.5 text-xs font-semibold text-primary-700 hover:bg-primary-50 dark:border-primary-300 dark:text-primary-300 dark:hover:bg-gray-800";
---

<article id={slug} class="scroll-mt-24 overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:border-primary-300 dark:border-gray-800 dark:bg-gray-900/50 dark:hover:border-primary-800">
  <div class="grid sm:grid-cols-[minmax(33.333%,1fr)_minmax(0,2fr)]">
    {data.image ? (
      <img src={data.image} alt="" class="h-28 min-h-28 w-full object-cover sm:h-full" loading="lazy" />
    ) : (
      <div role="img" aria-label={`${publicationType} publication`} class="flex min-h-28 items-center justify-center bg-gradient-to-br from-blue-100 to-emerald-100 p-3 dark:from-blue-950 dark:to-emerald-950">
        <svg viewBox="0 0 24 24" class="h-7 w-7 text-primary-700 dark:text-primary-300" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M5 4.75A1.75 1.75 0 0 1 6.75 3H20v16H6.75A1.75 1.75 0 0 0 5 20.75v-16Z" />
          <path d="M5 17.5c.48-.32 1.06-.5 1.75-.5H20M8 7h8m-8 3h8" />
        </svg>
      </div>
    )}

    <div class="min-w-0 p-4 sm:p-5">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-5 text-gray-500 dark:text-gray-400 sm:text-base sm:leading-6">
        {data.status !== "published" && <span class={`rounded px-1.5 py-0.5 font-semibold ${STATUS_BADGE[data.status]}`}>{STATUS_LABEL[data.status]}</span>}
        <span class="line-clamp-2 text-gray-700 dark:text-gray-300">{data.authors}</span>
        {publicationDate && <><span class="text-primary-500" aria-hidden="true">·</span><time datetime={data.date?.toISOString()}>{publicationDate}</time></>}
        {data.venue && <><span class="text-primary-500" aria-hidden="true">·</span><em>{data.venue}</em></>}
      </div>
      <h3 class="mb-2 mt-3 text-base font-semibold leading-6 text-gray-900 dark:text-gray-100 sm:text-lg">
        <a href={`/research#${slug}`} class="hover:text-primary-700 dark:hover:text-primary-300">{data.title}</a>
      </h3>
      {data.summary && <p class="line-clamp-2 text-base leading-6 text-gray-600 dark:text-gray-300">{data.summary}</p>}

      <div class="mt-3 flex flex-wrap gap-1.5">
        {pdfLink && <a class={buttonClass} href={pdfLink} target="_blank" rel="noopener noreferrer">PDF</a>}
        <button class={buttonClass} type="button" data-cite-copy={citation}>Cite</button>
        <button class={buttonClass} type="button" data-paper-open={dialogId} aria-haspopup="dialog" aria-controls={dialogId}>Details</button>
        {data.datasetUrl && <a class={buttonClass} href={data.datasetUrl} target="_blank" rel="noopener noreferrer">Dataset</a>}
        {data.projectUrl && <a class={buttonClass} href={data.projectUrl} target="_blank" rel="noopener noreferrer">Project</a>}
        {data.codeUrl && <a class={buttonClass} href={data.codeUrl} target="_blank" rel="noopener noreferrer">Code</a>}
        {doiLink && <a class={buttonClass} href={doiLink} target="_blank" rel="noopener noreferrer">DOI</a>}
      </div>
      <p data-cite-status role="status" aria-live="polite" class="mt-1 text-[10px] text-gray-500 dark:text-gray-400"></p>
    </div>
  </div>

  <dialog id={dialogId} data-paper-dialog aria-labelledby={`${dialogId}-title`} class="m-auto max-h-[85vh] w-[calc(100%-2rem)] max-w-2xl overflow-y-auto rounded border border-gray-200 bg-white p-0 text-left text-gray-900 shadow-2xl backdrop:bg-black/60 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100">
    <div class="flex items-start justify-between gap-4 border-b border-gray-200 p-4 dark:border-gray-700">
      <div class="min-w-0">
        <p class="text-xs font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">{STATUS_LABEL[data.status]}</p>
        <h3 id={`${dialogId}-title`} class="mt-1 text-lg font-bold leading-6">{data.title}</h3>
      </div>
      <button type="button" data-paper-close class="shrink-0 rounded border border-gray-300 px-2 py-1 text-xs font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800">Close</button>
    </div>
    <div class="space-y-4 p-4">
    {data.image && (
      <figure>
        <a href={data.image} target="_blank" rel="noopener noreferrer" aria-label={`Open full-size image for ${data.title}`}>
          <img src={data.image} alt={`Image for ${data.title}`} class="max-h-[65vh] w-full rounded object-contain" loading="lazy" />
        </a>
        <figcaption class="mt-1 text-center text-[10px] text-gray-500 dark:text-gray-400">Select image to open full size</figcaption>
      </figure>
    )}
      <p class="text-sm leading-5 text-gray-700 dark:text-gray-300">{citation}</p>
      <dl class="grid gap-x-4 gap-y-2 text-xs sm:grid-cols-[7rem_minmax(0,1fr)]">
        <dt class="font-semibold text-gray-500 dark:text-gray-400">Authors</dt>
        <dd>{data.authors}</dd>
        {data.venue && <><dt class="font-semibold text-gray-500 dark:text-gray-400">Journal / venue</dt><dd>{data.venue}</dd></>}
        {data.publisher && <><dt class="font-semibold text-gray-500 dark:text-gray-400">Publisher</dt><dd>{data.publisher}</dd></>}
        {data.date && <><dt class="font-semibold text-gray-500 dark:text-gray-400">Date</dt><dd><FormattedDate date={data.date} /></dd></>}
        {data.citationDetails && <><dt class="font-semibold text-gray-500 dark:text-gray-400">Publication</dt><dd>{data.citationDetails}</dd></>}
        {data.doi && <><dt class="font-semibold text-gray-500 dark:text-gray-400">DOI</dt><dd>{data.doi}</dd></>}
      </dl>
      <section>
        <h4 class="text-sm font-semibold">Description</h4>
        <p class="mt-1 whitespace-pre-line text-xs leading-5 text-gray-700 dark:text-gray-300">{data.summary?.trim() || "No description has been added yet."}</p>
      </section>
      <div class="flex flex-wrap gap-1.5">
        {pdfLink && <a class={buttonClass} href={pdfLink} target="_blank" rel="noopener noreferrer">PDF</a>}
        {data.datasetUrl && <a class={buttonClass} href={data.datasetUrl} target="_blank" rel="noopener noreferrer">Dataset</a>}
        {data.projectUrl && <a class={buttonClass} href={data.projectUrl} target="_blank" rel="noopener noreferrer">Project</a>}
        {data.codeUrl && <a class={buttonClass} href={data.codeUrl} target="_blank" rel="noopener noreferrer">Code</a>}
        {doiLink && <a class={buttonClass} href={doiLink} target="_blank" rel="noopener noreferrer">DOI</a>}
      </div>
    </div>
  </dialog>
</article>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-cite-copy]").forEach((button) => {
    button.addEventListener("click", async () => {
      const citation = button.dataset.citeCopy;
      const status = button.closest("article")?.querySelector<HTMLElement>("[data-cite-status]");
      if (!citation || !status) {
        console.error("Could not find citation text or status element for this publication.");
        return;
      }

      try {
        await navigator.clipboard.writeText(citation);
        status.textContent = "Citation copied.";
      } catch (error) {
        status.textContent = "Could not copy citation. Open Details to copy it manually.";
        console.error("Could not copy publication citation.", error);
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-paper-open]").forEach((button) => {
    const dialogId = button.dataset.paperOpen;
    const dialog = dialogId ? document.getElementById(dialogId) as HTMLDialogElement | null : null;
    button.addEventListener("click", () => dialog?.showModal());
  });

  document.querySelectorAll<HTMLDialogElement>("[data-paper-dialog]").forEach((dialog) => {
    dialog.querySelector<HTMLButtonElement>("[data-paper-close]")?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>
