---
import type { CollectionEntry } from "astro:content";
import PaperDialog from "@/components/PaperDialog.astro";
import ShareButton from "@/components/ShareButton.astro";
import ReactionBar from "@/components/ReactionBar.astro";
import { reactionsAvailable } from "@/reactions";
import { pagesData } from "@/data/content";
import { STATUS_BADGE, STATUS_LABEL, doiUrl, paperCitation, paperPdfUrl } from "@/research-ui";

interface Props {
  entry: CollectionEntry<"research">;
  /** Homepage row: no image, no extra buttons. */
  compact?: boolean;
}

const { entry, compact = false } = Astro.props;
const { data, slug } = entry;
const citation = paperCitation(data);
const pdfLink = paperPdfUrl(data.pdfUrl, data.url, data.preprintUrl);
const doiLink = doiUrl(data.doi);
const publicationDate = data.date
  ? `${data.date.toLocaleDateString("en-US", { month: "long" })}, ${data.date.getFullYear()}`
  : undefined;
const publicationType = data.publicationType === "conference"
  ? "Conference"
  : data.publicationType === "thesis"
    ? "Thesis"
    : "Journal";
const dialogId = `details-${slug}`;
const shareUrl = new URL(`/research/${slug}/`, Astro.site).href; // each paper has its own page + link preview
const buttonClass = "inline-flex min-h-9 items-center rounded-md border border-primary-700 px-3 py-1.5 text-xs font-semibold text-primary-700 hover:bg-primary-50 dark:border-primary-300 dark:text-primary-300 dark:hover:bg-gray-800";
---

{compact ? (
<article id={slug} class="scroll-mt-24 rounded-xl border border-gray-200 bg-white/80 p-4 dark:border-gray-800 dark:bg-gray-900/50 sm:p-5">
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-500 dark:text-gray-400">
    {data.status !== "published" && <span class={`rounded px-1.5 py-0.5 text-xs font-semibold ${STATUS_BADGE[data.status]}`}>{STATUS_LABEL[data.status]}</span>}
    {data.venue && <em>{data.venue}</em>}
    {publicationDate && <><span class="text-primary-500" aria-hidden="true">·</span><time datetime={data.date?.toISOString()}>{publicationDate}</time></>}
  </div>
  <h3 class="mt-2 text-base font-semibold leading-6 text-gray-900 dark:text-gray-100 sm:text-lg">
    <button type="button" data-paper-open={dialogId} aria-haspopup="dialog" aria-controls={dialogId} class="text-left hover:text-primary-700 dark:hover:text-primary-300">{data.title}</button>
  </h3>
  {data.tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Topics">
      {data.tags.slice(0, 3).map((tag) => <li class="rounded-md bg-primary-50 px-2 py-0.5 text-xs font-medium text-primary-800 dark:bg-primary-950 dark:text-primary-200">{tag}</li>)}
    </ul>
  )}
  <div class="mt-2 flex flex-wrap gap-1.5">
    <button class={buttonClass} type="button" data-paper-open={dialogId} aria-haspopup="dialog" aria-controls={dialogId}>Details</button>
    {pdfLink && <a class={buttonClass} href={pdfLink} target="_blank" rel="noopener noreferrer">PDF</a>}
    {doiLink && <a class={buttonClass} href={doiLink} target="_blank" rel="noopener noreferrer">DOI</a>}
  </div>
  <PaperDialog entry={entry} />
</article>
) : (
<article id={slug} class="scroll-mt-24 overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:border-primary-300 target:border-primary-400 target:ring-2 target:ring-primary-300 dark:border-gray-800 dark:bg-gray-900/50 dark:hover:border-primary-800 dark:target:ring-primary-700">
  <div class="grid items-stretch grid-cols-[9rem_minmax(0,1fr)] sm:grid-cols-[12rem_minmax(0,1fr)] lg:grid-cols-[minmax(14rem,0.38fr)_minmax(0,1fr)]">
    <div class="min-w-0 p-2 sm:p-3">
      <div class="flex h-full min-h-36 items-center justify-center overflow-hidden rounded-lg border border-gray-200 bg-gray-50 p-1.5 dark:border-gray-800 dark:bg-gray-950 sm:min-h-40 lg:min-h-44">
        {data.image ? (
          <img src={data.image} alt={`Cover image for ${data.title}`} class="max-h-44 w-full object-contain sm:max-h-48 lg:max-h-52" loading="lazy" />
        ) : (
          <div role="img" aria-label={`${publicationType} publication`} class="flex h-full min-h-36 w-full items-center justify-center bg-gradient-to-br from-primary-50 to-white dark:from-primary-950 dark:to-gray-900">
            <svg viewBox="0 0 24 24" class="h-8 w-8 text-primary-700 dark:text-primary-300" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              <path d="M5 4.75A1.75 1.75 0 0 1 6.75 3H20v16H6.75A1.75 1.75 0 0 0 5 20.75v-16Z" />
              <path d="M5 17.5c.48-.32 1.06-.5 1.75-.5H20M8 7h8m-8 3h8" />
            </svg>
          </div>
        )}
      </div>
    </div>

    <div class="min-w-0 self-center p-3 sm:p-4">
      <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-sm leading-5 text-gray-500 dark:text-gray-400 sm:text-base sm:leading-6">
        {data.status !== "published" && <span class={`rounded px-1.5 py-0.5 font-semibold ${STATUS_BADGE[data.status]}`}>{STATUS_LABEL[data.status]}</span>}
        <span class="line-clamp-2 text-gray-700 dark:text-gray-300">{data.authors}</span>
        {publicationDate && <><span class="text-primary-500" aria-hidden="true">·</span><time datetime={data.date?.toISOString()}>{publicationDate}</time></>}
        {data.venue && <><span class="text-primary-500" aria-hidden="true">·</span><em>{data.venue}</em></>}
      </div>
      <h3 class="mb-2 mt-1 text-base font-semibold leading-6 text-gray-900 dark:text-gray-100 sm:text-lg">
        <button type="button" data-paper-open={dialogId} aria-haspopup="dialog" aria-controls={dialogId} class="text-left hover:text-primary-700 dark:hover:text-primary-300">{data.title}</button>
      </h3>
      {data.summary && <p class="line-clamp-2 text-base leading-6 text-gray-600 dark:text-gray-300">{data.summary}</p>}
      {data.tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5" aria-label="Topics">
          {data.tags.slice(0, 4).map((tag) => <li class="rounded-md bg-primary-50 px-2 py-0.5 text-xs font-medium text-primary-800 dark:bg-primary-950 dark:text-primary-200">{tag}</li>)}
        </ul>
      )}

      <div class="mt-2 flex flex-wrap gap-1.5">
        {pdfLink && <a class={buttonClass} href={pdfLink} target="_blank" rel="noopener noreferrer">PDF</a>}
        <button class={buttonClass} type="button" data-cite-copy={citation}>Cite</button>
        <button class={buttonClass} type="button" data-paper-open={dialogId} aria-haspopup="dialog" aria-controls={dialogId}>Details</button>
        <ShareButton url={shareUrl} label={pagesData.research.shareLabel} />
        {data.datasetUrl && <a class={buttonClass} href={data.datasetUrl} target="_blank" rel="noopener noreferrer">Dataset</a>}
        {data.projectUrl && <a class={buttonClass} href={data.projectUrl} target="_blank" rel="noopener noreferrer">Project</a>}
        {data.codeUrl && <a class={buttonClass} href={data.codeUrl} target="_blank" rel="noopener noreferrer">Code</a>}
        {doiLink && <a class={buttonClass} href={doiLink} target="_blank" rel="noopener noreferrer">DOI</a>}
      </div>
      {reactionsAvailable() && <div class="mt-3"><ReactionBar id={`paper:${slug}`} compact /></div>}
      <p data-cite-status role="status" aria-live="polite" class="mt-1 text-[10px] text-gray-500 dark:text-gray-400"></p>
    </div>
  </div>

  <PaperDialog entry={entry} />
</article>
)}
