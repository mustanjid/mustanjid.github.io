---
import Link from "./Link.astro";
import {NAVIGATION} from '@/consts';
---
<button aria-label="Open menu" aria-expanded="false" aria-controls="mobileMenuContainer" class="toggle-menu rounded-lg p-1.5 text-gray-800 transition hover:bg-gray-100 dark:text-gray-100 dark:hover:bg-gray-800">
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-6 w-6" aria-hidden="true">
    <path fillRule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1z" clipRule="evenodd"/>
  </svg>
</button>
<div id="mobileMenuContainer" hidden class="fixed right-4 top-[4.5rem] z-[60] max-h-[min(70vh,34rem)] w-[min(19rem,calc(100vw-2rem))] overflow-y-auto rounded-2xl border border-gray-200 bg-white p-2 shadow-2xl dark:border-gray-700 dark:bg-gray-900">
  <div class="flex items-center justify-between border-b border-gray-100 px-3 py-2 dark:border-gray-800">
    <span class="font-mono text-[11px] font-semibold uppercase tracking-widest text-gray-500 dark:text-gray-400">Navigation</span>
    <button class="toggle-menu rounded-md p-1.5 text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-800" aria-label="Close menu">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true"><path fillRule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clipRule="evenodd"/></svg>
    </button>
  </div>
  <nav aria-label="Mobile navigation" class="py-1">
    {NAVIGATION.map(({href, title}) => (
      <Link href={href} class="block rounded-xl px-3 py-3 text-base font-semibold text-gray-800 transition hover:bg-gray-50 hover:text-primary-700 dark:text-gray-100 dark:hover:bg-gray-800 dark:hover:text-primary-300">
        {title}
      </Link>
    ))}
  </nav>
</div>

<script>
  function bindMenu() {
    const menu = document.getElementById("mobileMenuContainer");
    if (!menu) return;
    document.querySelectorAll<HTMLButtonElement>(".toggle-menu").forEach((button) => {
      if (button.dataset.menuBound === "true") return;
      button.dataset.menuBound = "true";
      button.addEventListener("click", () => {
        const willOpen = menu.hidden;
        menu.hidden = !willOpen;
        document.querySelectorAll<HTMLButtonElement>('.toggle-menu[aria-controls="mobileMenuContainer"]').forEach((toggle) => {
          toggle.setAttribute("aria-expanded", String(willOpen));
        });
      });
    });
    menu.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      if (link.dataset.menuBound === "true") return;
      link.dataset.menuBound = "true";
      link.addEventListener("click", () => { menu.hidden = true; });
    });
  }
  bindMenu();
  document.addEventListener("astro:page-load", bindMenu);
</script>
