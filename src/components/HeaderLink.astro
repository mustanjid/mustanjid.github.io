---
import type {HTMLAttributes} from 'astro/types';

type Props = HTMLAttributes<'a'>;

const {href, class: className, ...props} = Astro.props;

const {pathname} = Astro.url;
const normalizedPathname = pathname.replace(/\/+$/, '') || '/';
const normalizedHref = href?.replace(/\/+$/, '') || '/';
const isActive =
    normalizedPathname === normalizedHref ||
    (normalizedHref !== '/' && normalizedPathname.startsWith(`${normalizedHref}/`));
---

<a
    href={href}
    aria-current={isActive ? 'page' : undefined}
    class:list={[
        className,
        'relative rounded-md px-2 py-1 transition-colors hover:text-primary-700 dark:hover:text-primary-300',
        'after:absolute after:inset-x-2 after:-bottom-0.5 after:h-0.5 after:origin-left after:rounded-full after:bg-primary-500 after:transition-transform after:duration-300',
        isActive
            ? 'text-primary-700 after:scale-x-100 dark:text-primary-300'
            : 'text-gray-800 after:scale-x-0 hover:after:scale-x-100 dark:text-gray-200',
    ]}
    {...props}
>
    <slot/>
</a>
