---
// One card for every project category on the Projects page (Latest tab and each category tab).
// Only the image, the title and the buttons are links: the card itself is not, so scrolling and tapping on a
// phone never opens a project by accident.
import type { CollectionEntry } from "astro:content";
import { STAGE_LABEL } from "@/functions";
import { pagesData } from "@/data/content";
import ShareButton from "@/components/ShareButton.astro";
import WorkStamp from "@/components/WorkStamp.astro";
import ReactionBar from "@/components/ReactionBar.astro";
import { reactionsAvailable } from "@/reactions";

interface Props {
    project: CollectionEntry<"projects">;
    categoryName: string;
    /** "latest" shows more of the project (longer description, more chips) than the plain list card. */
    variant?: "latest" | "list";
}

const { project, categoryName, variant = "list" } = Astro.props;
const { data, slug } = project;
const t = pagesData.projects;
const isLatest = variant === "latest";
const href = `/projects/${slug}/`;
const shareUrl = new URL(href, Astro.site).href;
const stage = data.stage ? STAGE_LABEL[data.stage] : undefined;

const stackLimit = isLatest ? 7 : 5;
const areaLimit = isLatest ? 4 : 3;
const stack = data.stack.slice(0, stackLimit);
const moreStack = data.stack.length - stack.length;
const areas = data.areas.slice(0, areaLimit);
const isResearch = data.kind.includes("research");
const hasDemo = Boolean(data.url);

const chip = "rounded-md px-2 py-0.5 text-xs font-medium";
const linkClass = "text-sm font-semibold text-primary-700 hover:underline dark:text-primary-300";
const primaryClass = "inline-flex items-center gap-1 rounded-lg bg-primary-700 px-3.5 py-1.5 text-sm font-semibold text-white transition hover:bg-primary-800 dark:bg-primary-500 dark:text-gray-950 dark:hover:bg-primary-400";
---

<article class="group/card flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900/50">
    <div class="relative shrink-0 p-3 pb-0">
        {data.featured && <WorkStamp />}
        <a href={href} class="block overflow-hidden rounded-xl border border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950" aria-label={`${t.detailsLabel}: ${data.title}`}>
            {/* Window bar makes a screenshot read as "a running thing"; research figures skip it. */}
            {!isResearch && (
                <div class="flex items-center gap-1.5 border-b border-gray-200 bg-white px-3 py-2 dark:border-gray-800 dark:bg-gray-900" aria-hidden="true">
                    <span class="h-2 w-2 rounded-full bg-rose-400"></span><span class="h-2 w-2 rounded-full bg-amber-400"></span><span class="h-2 w-2 rounded-full bg-emerald-400"></span>
                </div>
            )}
            <div class="aspect-video overflow-hidden">
                {data.imgSrc ? (
                    <img src={data.imgSrc} alt="" class:list={["h-full w-full transition-transform duration-500 group-hover/card:scale-[1.03]", isResearch ? "bg-white object-contain p-2" : "object-cover object-top"]} loading="lazy" decoding="async" />
                ) : (
                    <div class="flex h-full items-end bg-gradient-to-br from-primary-100 via-primary-50 to-emerald-50 p-5 dark:from-primary-950 dark:via-gray-900 dark:to-gray-950">
                        <span class="text-sm font-bold uppercase tracking-[0.2em] text-primary-800 dark:text-primary-200">{categoryName}</span>
                    </div>
                )}
            </div>
        </a>
    </div>

    <div class="flex flex-1 flex-col p-5 pt-4">
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-gray-500 dark:text-gray-400">
            <span class="font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">{categoryName}</span>
            {stage && <><span aria-hidden="true">·</span><span class="inline-flex items-center gap-1"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>{stage}</span></>}
            {data.date && <><span aria-hidden="true">·</span><time datetime={data.date.toISOString()}>{data.date.toLocaleDateString("en-US", { month: "short", year: "numeric" })}</time></>}
        </div>

        <h2 class="mt-2 text-xl font-bold leading-7 text-gray-900 dark:text-gray-100">
            <a href={href} class="hover:text-primary-700 dark:hover:text-primary-300">{data.title}</a>
        </h2>

        {data.description && <p class:list={["mt-2 text-sm leading-6 text-gray-600 dark:text-gray-300", isLatest ? "line-clamp-4" : "line-clamp-3"]}>{data.description}</p>}

        {stack.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-1.5" aria-label={t.toolsLabel}>
                {stack.map((item) => <li class:list={[chip, "bg-primary-50 text-primary-800 dark:bg-primary-950 dark:text-primary-200"]}>{item}</li>)}
                {moreStack > 0 && <li class:list={[chip, "bg-gray-100 text-gray-600 dark:bg-gray-800 dark:text-gray-300"]}>+{moreStack}</li>}
            </ul>
        )}

        {areas.length > 0 && (
            <p class="mt-3 text-xs leading-5 text-gray-500 dark:text-gray-400"><span class="font-semibold uppercase tracking-wide">{t.areasLabel}:</span>{` ${areas.join(" · ")}`}</p>
        )}

        <div class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 pt-5">
            {hasDemo ? (
                <a class={primaryClass} href={data.url} target="_blank" rel="noopener noreferrer">{t.liveLabel} <span aria-hidden="true">&nearr;</span></a>
            ) : (
                <a href={href} class={primaryClass}>{t.detailsLabel} <span aria-hidden="true">&rarr;</span></a>
            )}
            {hasDemo && <a href={href} class={linkClass}>{t.detailsLabel}</a>}
            {data.srccode && <a class={linkClass} href={data.srccode} target="_blank" rel="noopener noreferrer">{t.sourceLabel}</a>}
            {data.projectdesc && <a class={linkClass} href={data.projectdesc} target="_blank" rel="noopener noreferrer">{t.notesLabel}</a>}
            <span class="ml-auto"><ShareButton url={shareUrl} label={t.shareLabel} /></span>
        </div>
        {reactionsAvailable() && <div class="pt-3"><ReactionBar id={`project:${slug}`} compact /></div>}
    </div>
</article>
