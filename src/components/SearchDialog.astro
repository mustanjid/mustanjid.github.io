---
// ⌘K / Ctrl+K search over thoughts, research, projects and pages. The index is /search.json (built at deploy time).
---

<button type="button" data-search-open aria-label="Search" aria-haspopup="dialog" class="inline-flex items-center gap-2 rounded-lg border border-gray-300/80 bg-white/60 px-2.5 py-1.5 text-sm text-gray-600 transition hover:border-primary-400 hover:text-primary-700 dark:border-gray-700 dark:bg-gray-900/60 dark:text-gray-300 dark:hover:text-primary-300">
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
  <span class="hidden sm:inline">Search</span>
  <kbd class="hidden rounded border border-gray-300 px-1.5 text-[11px] font-medium text-gray-500 dark:border-gray-600 dark:text-gray-400 md:inline">Ctrl K</kbd>
</button>

<dialog data-search-dialog aria-label="Search the site" class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none bg-transparent p-0 text-gray-900 backdrop:bg-slate-950/50 backdrop:backdrop-blur-sm dark:text-gray-100">
  <div data-search-surface class="mx-auto mt-[12vh] w-[min(92vw,38rem)] overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-2xl dark:border-gray-700 dark:bg-gray-900">
    <div class="flex items-center gap-3 border-b border-gray-200 px-4 dark:border-gray-700">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0 text-gray-500"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      <input data-search-input type="search" autocomplete="off" spellcheck="false" placeholder="Search thoughts, research, projects…" aria-label="Search query" aria-controls="search-results" class="h-14 w-full border-0 bg-transparent text-base text-gray-900 placeholder:text-gray-500 focus:ring-0 dark:text-gray-100 [&::-webkit-search-cancel-button]:hidden" />
      <button type="button" data-search-close class="rounded-md border border-gray-300 px-2 py-0.5 text-xs text-gray-600 dark:border-gray-600 dark:text-gray-300">Esc</button>
    </div>
    <ul id="search-results" role="listbox" data-search-results class="max-h-[50vh] overflow-y-auto p-2"></ul>
    <p data-search-status role="status" aria-live="polite" class="px-4 pb-3 pt-1 text-xs text-gray-500 dark:text-gray-400"></p>
  </div>
</dialog>

<script>
  type Item = { type: string; title: string; url: string; text: string };
  const w = window as unknown as { __searchReady?: boolean; __searchIndex?: Promise<Item[]> };

  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s);
  const loadIndex = () => (w.__searchIndex ??= fetch("/search.json").then((r) => r.json()).catch(() => []));

  const score = (item: Item, terms: string[]) => {
    const title = item.title.toLowerCase();
    const text = item.text.toLowerCase();
    let total = 0;
    for (const t of terms) {
      if (title.startsWith(t)) total += 6;
      else if (title.includes(t)) total += 4;
      else if (text.includes(t)) total += 1;
      else return 0; // every word must match somewhere
    }
    return total;
  };

  let active = -1;
  const rows = () => Array.from(document.querySelectorAll<HTMLElement>("[data-search-results] [role=option]"));
  const setActive = (i: number) => {
    const r = rows();
    if (!r.length) return;
    active = (i + r.length) % r.length;
    r.forEach((el, n) => el.setAttribute("aria-selected", String(n === active)));
    r[active].scrollIntoView({ block: "nearest" });
  };

  const render = async () => {
    const input = $<HTMLInputElement>("[data-search-input]");
    const list = $("[data-search-results]");
    const status = $("[data-search-status]");
    if (!input || !list || !status) return;
    const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    const index = await loadIndex();
    const hits = terms.length
      ? index.map((item) => ({ item, s: score(item, terms) })).filter((h) => h.s > 0).sort((a, b) => b.s - a.s).slice(0, 8).map((h) => h.item)
      : index.filter((i) => i.type === "Page").slice(0, 8);
    list.replaceChildren(
      ...hits.map((h, n) => {
        const li = document.createElement("li");
        li.setAttribute("role", "option");
        li.setAttribute("aria-selected", "false");
        li.className = "cursor-pointer rounded-xl px-3 py-2 aria-selected:bg-primary-50 dark:aria-selected:bg-gray-800";
        const a = document.createElement("a");
        a.href = h.url;
        a.className = "block focus:outline-none";
        const top = document.createElement("div");
        top.className = "flex items-center justify-between gap-3";
        const title = document.createElement("span");
        title.className = "truncate font-semibold";
        title.textContent = h.title;
        const badge = document.createElement("span");
        badge.className = "shrink-0 rounded-full bg-gray-100 px-2 py-0.5 text-[11px] font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300";
        badge.textContent = h.type;
        top.append(title, badge);
        a.append(top);
        if (h.text) {
          const p = document.createElement("p");
          p.className = "mt-0.5 line-clamp-1 text-sm text-gray-600 dark:text-gray-400";
          p.textContent = h.text;
          a.append(p);
        }
        li.append(a);
        li.dataset.n = String(n);
        return li;
      }),
    );
    status.textContent = terms.length ? (hits.length ? `${hits.length} result${hits.length > 1 ? "s" : ""}` : "No results") : "Type to search. Use ↑ ↓ and Enter.";
    active = -1;
    if (hits.length && terms.length) setActive(0);
  };

  const open = () => {
    const d = $<HTMLDialogElement>("[data-search-dialog]");
    const input = $<HTMLInputElement>("[data-search-input]");
    if (!d || d.open) return;
    d.showModal();
    if (input) input.value = "";
    render();
    input?.focus();
  };
  const close = () => $<HTMLDialogElement>("[data-search-dialog]")?.close();

  if (!w.__searchReady) {
    w.__searchReady = true;
    document.addEventListener("click", (e) => {
      const t = e.target as HTMLElement;
      if (t.closest("[data-search-open]")) open();
      else if (t.closest("[data-search-close]")) close();
      else if (t.matches("[data-search-dialog]") || t.closest("[data-search-results] a")) close();
    });
    document.addEventListener("input", (e) => {
      if ((e.target as HTMLElement).matches("[data-search-input]")) render();
    });
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        open();
        return;
      }
      const d = $<HTMLDialogElement>("[data-search-dialog]");
      if (!d?.open) return;
      if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
      else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
      else if (e.key === "Enter") {
        const a = rows()[Math.max(active, 0)]?.querySelector("a");
        if (a) { e.preventDefault(); a.click(); }
      }
    });
    document.addEventListener("astro:before-swap", close);
  }
</script>
