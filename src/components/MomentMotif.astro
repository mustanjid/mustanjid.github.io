---
interface Props {
  category: string;
}

const { category } = Astro.props;
const sketches = [
  { motif: "art", accent: "text-rose-500/40 dark:text-rose-300/30" },
  { motif: "gears", accent: "text-amber-600/40 dark:text-amber-300/30" },
  { motif: "city", accent: "text-sky-500/40 dark:text-sky-300/30" },
  { motif: "leaf", accent: "text-orange-500/40 dark:text-orange-300/30" },
  { motif: "lake", accent: "text-cyan-600/40 dark:text-cyan-300/30" },
  { motif: "mountains", accent: "text-indigo-500/40 dark:text-indigo-300/30" },
] as const;
const categoryHash = Array.from(category).reduce(
  (hash, character) => (hash * 31 + character.charCodeAt(0)) >>> 0,
  7,
);
const sketch = sketches[categoryHash % sketches.length];
const { motif, accent } = sketch;
---

<svg
  aria-hidden="true"
  viewBox="0 0 400 220"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  class:list={["pointer-events-none absolute inset-0 h-full w-full opacity-30", accent]}
>
  {motif === "art" && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round">
      <path d="M-20 180C55 120 90 205 155 140S265 55 420 125M-15 205C65 155 90 225 175 165S305 95 420 165" />
      <path d="M32 68c28-22 49 18 77-4s45-28 66-10m61 118c22-20 43-18 65-42" stroke-width="2" />
      <circle cx="90" cy="53" r="5" fill="currentColor" /><circle cx="260" cy="55" r="7" fill="currentColor" /><circle cx="340" cy="190" r="5" fill="currentColor" />
    </g>
  )}
  {motif === "gears" && (
    <g stroke="currentColor" stroke-width="3">
      <circle cx="285" cy="108" r="66" /><circle cx="285" cy="108" r="24" />
      <circle cx="365" cy="166" r="38" /><circle cx="365" cy="166" r="13" />
      <path d="M285 22v20m0 132v20m-86-86h20m132 0h20m-147-61 15 15m93 93 15 15m0-123-15 15m-93 93-15 15M365 116v12m0 76v12m-50-50h12m76 0h12m-85-35 9 9m54 54 9 9" stroke-linecap="round" />
      <path d="M10 190h120m16 0h52" stroke-width="2" stroke-linecap="round" />
    </g>
  )}
  {motif === "city" && (
    <g stroke="currentColor" stroke-width="3" stroke-linejoin="round">
      <path d="M138 206V108l48-33v131m0 0V45l64-25v186m0 0V96l64 25v85m0 0v-72l48 22v50Z" />
      <path d="M155 125h12m-12 19h12m-12 19h12m-12 19h12m28-116h15m-15 22h15m-15 22h15m-15 22h15m-15 22h15m-15 22h15m30-130h15m-15 22h15m-15 22h15m-15 22h15m15 19h14m-14 19h14m-14 19h14M108 206h282" stroke-width="2" />
    </g>
  )}
  {motif === "leaf" && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <path d="M338 27C247 22 185 72 197 141c9 52 60 75 104 44 43-31 45-99 37-158Z" />
      <path d="M210 197c36-57 77-102 128-157m-88 99-5-48m43 12 38 3m-74 47-8 36m48-86 30-28" />
      <path d="M18 183c40-25 67-24 97-2" stroke-width="2" />
    </g>
  )}
  {motif === "lake" && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="320" cy="62" r="27" />
      <path d="M-15 115c43-30 86-30 129 0s86 30 129 0 86-30 129 0 43 30 58 22M-15 153c43-30 86-30 129 0s86 30 129 0 86-30 129 0 43 30 58 22M24 190h350" />
      <path d="M286 62h-37m179 0h-37m-71-35V-5m0 134V99" stroke-width="2" />
    </g>
  )}
  {motif === "mountains" && (
    <g stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="326" cy="56" r="24" />
      <path d="m24 198 88-127 59 82 66-105 118 150H24Z" />
      <path d="m87 107 25-36 25 35m76-10 24-48 28 45m-174 91h206" stroke-width="2" />
    </g>
  )}
</svg>
