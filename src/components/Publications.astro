---
import { getResearchEntries } from "@/functions";
import PublicationCard from "@/components/PublicationCard.astro";
import { settings } from "@/data/settings";

const entries = await getResearchEntries();
const underReview = entries.filter(({ data }) => data.status === "under-review" || data.status === "submitted");
const thesis = entries.filter(({ data }) => data.publicationType === "thesis");
const journal = entries.filter(({ data }) => data.publicationType === "journal" && data.status !== "under-review" && data.status !== "submitted");
const conference = entries.filter(({ data }) => data.publicationType === "conference");
const groupedEntries = [
  { title: "Under Review", items: underReview },
  { title: "Journal", items: journal },
  { title: "Conference", items: conference },
  { title: "Thesis", items: thesis },
].filter(({ items }) => items.length > 0);

const scholarUrl = settings.scholarUrl ?? "https://scholar.google.com/scholar?q=%22Md+Al+Mustanjid%22";
---

<section aria-labelledby="publications-title" class="mt-12 space-y-7">
  <header class="flex flex-wrap items-end justify-between gap-4 border-b border-gray-200 pb-4 dark:border-gray-700">
    <h2 id="publications-title" class="text-3xl font-extrabold leading-tight text-gray-900 dark:text-gray-100">Publications</h2>
    <a class="text-sm font-semibold text-primary-600 hover:underline dark:text-primary-400" href={scholarUrl} target="_blank" rel="noopener noreferrer">200+ citations on Google Scholar</a>
  </header>

  {entries.length === 0 && <p class="text-gray-500 dark:text-gray-400">No publications yet.</p>}

  {groupedEntries.map((group) => (
    <section aria-label={group.title} class="space-y-3">
      <h3 class="text-2xl font-bold text-gray-900 dark:text-gray-100">{group.title}</h3>
      <ul class="space-y-3">
        {group.items.map((entry) => <li><PublicationCard entry={entry} /></li>)}
      </ul>
    </section>
  ))}
</section>
