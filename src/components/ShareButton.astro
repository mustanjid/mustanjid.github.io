---
// Compact "Share" button for cards (research papers, projects). Uses the native share sheet where the browser has
// one, otherwise copies the link. The behaviour lives in ShareHandler, which is bundled once per page.
import ShareHandler from "@/components/ShareHandler.astro";

interface Props {
  /** Absolute page address to share. */
  url: string;
  title: string;
  text?: string;
  label?: string;
}

const { url, title, text, label = "Share" } = Astro.props;
---

<span data-share-root class="inline-flex items-center">
  <button
    type="button"
    data-share-action="native"
    data-share-url={url}
    data-share-title={title}
    data-share-text={text}
    class="inline-flex min-h-9 items-center gap-1.5 rounded-md border border-primary-700 px-3 py-1.5 text-xs font-semibold text-primary-700 hover:bg-primary-50 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-primary-300 dark:text-primary-300 dark:hover:bg-gray-800"
  >
    <svg xmlns="http://www.w3.org/2000/svg" height="14" width="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
      <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
    </svg>
    <span data-share-label>{label}</span>
  </button>
  <span data-share-status role="status" aria-live="polite" class="sr-only"></span>
</span>
<ShareHandler />
