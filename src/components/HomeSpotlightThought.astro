---
import { getCollection } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { excludeDrafts, sortBlogPosts } from "@/functions";
import { pagesData } from "@/data/content";

const posts = sortBlogPosts((await getCollection("blog", excludeDrafts)) ?? []).slice(0, 3);
---

<article aria-labelledby="my-thoughts-title" class="c2-card flex h-full min-w-0 flex-col">
  <h2 id="my-thoughts-title" class="c2-title m-0 text-xl">My thoughts</h2>

  {posts.length > 0 ? (
    <ul class="mt-3 list-none p-0 m-0">
      {posts.map((post, index) => (
        <li class="border-t border-[var(--c2-line)] py-3 first:border-t-0 first:pt-0">
          <time class="block text-xs text-[var(--c2-faint)]" datetime={post.data.date.toISOString()}><FormattedDate date={post.data.date} /></time>
          <a href={`/blog/${post.slug}`} class:list={["c2-title mt-1 block no-underline hover:text-[var(--c2-accent)]", index === 0 ? "text-base leading-snug line-clamp-3" : "text-sm leading-5 line-clamp-2"]}>
            {post.data.title}
          </a>
          {index === 0 && post.data.summary && <p class="c2-text mt-1 line-clamp-2 text-sm">{post.data.summary}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="c2-text mt-4 text-sm">{pagesData.home.thoughtsEmpty}</p>
  )}

  <div class="mt-auto pt-4">
    <a href="/blog" class="cta-ghost">View all</a>
  </div>
</article>
