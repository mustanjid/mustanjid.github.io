---
import { getCollection } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";
import { excludeDrafts, sortBlogPosts } from "@/functions";
import { pagesData } from "@/data/content";

const posts = sortBlogPosts((await getCollection("blog", excludeDrafts)) ?? []).slice(0, 3);
---

<article aria-labelledby="latest-thought-card-title" class="group flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white p-5 shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-primary-300 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900/60 dark:hover:border-primary-700 sm:p-6">
  <div class="flex items-center justify-between gap-3">
    <p class="text-xs font-semibold uppercase tracking-[0.15em] text-primary-700 dark:text-primary-300">Notes & ideas</p>
    <span class="grid h-9 w-9 place-items-center rounded-xl border border-gray-200 bg-gray-50 text-lg dark:border-gray-700 dark:bg-gray-950" aria-hidden="true">✎</span>
  </div>
  <h2 id="latest-thought-card-title" class="mt-3 text-xl font-bold text-gray-950 dark:text-gray-50">{pagesData.home.latestThoughtsTitle}</h2>

  {posts.length > 0 ? (
    <ul class="mt-3 divide-y divide-gray-100 dark:divide-gray-800">
      {posts.map((post, index) => (
        <li class="py-3 first:pt-0 last:pb-0">
          <time class="block text-[11px] text-gray-500 dark:text-gray-400" datetime={post.data.date.toISOString()}><FormattedDate date={post.data.date} /></time>
          <a href={`/blog/${post.slug}`} class:list={["mt-1 block text-sm font-semibold leading-5 text-gray-800 transition hover:text-primary-700 dark:text-gray-200 dark:hover:text-primary-300", index === 0 ? "line-clamp-3 text-base" : "line-clamp-2"]}>
            {post.data.title}
          </a>
          {index === 0 && post.data.summary && <p class="mt-1 line-clamp-2 text-xs leading-5 text-gray-500 dark:text-gray-400">{post.data.summary}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-4 text-sm text-gray-500 dark:text-gray-400">{pagesData.home.thoughtsEmpty}</p>
  )}

  <a href="/blog" class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-semibold text-primary-700 hover:underline dark:text-primary-300">
    {pagesData.home.allThoughtsButton} <span aria-hidden="true">→</span>
  </a>
</article>
