---
import { pagesData } from "@/data/content";
import { settings } from "@/data/settings";
import FormattedDate from "@/components/FormattedDate.astro";

const { enabled, text, updatedAt, url } = settings.rightNow;
const show = enabled && text.trim().length > 0;
const ageDays = updatedAt ? Math.floor((Date.now() - updatedAt.getTime()) / 86_400_000) : undefined;
const stale = ageDays !== undefined && ageDays > 30;
---

{show && (
  <section
    aria-label="Currently learning"
    class:list={[
      "c2-card flex w-full flex-wrap items-center gap-x-3 gap-y-2 text-sm",
      stale && "opacity-65",
    ]}
  >
    <span class="inline-flex shrink-0 items-center gap-2 font-semibold uppercase tracking-[0.13em] text-emerald-700 dark:text-emerald-400">
      <span class="relative flex h-2.5 w-2.5" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-60"></span>
        <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-emerald-500"></span>
      </span>
      {pagesData.home.nowLabel}
    </span>
    {url ? (
      <a class="min-w-0 flex-1 font-medium text-gray-800 hover:text-emerald-700 hover:underline dark:text-gray-200 dark:hover:text-emerald-300" href={url}>{text}</a>
    ) : (
      <p class="min-w-0 flex-1 font-medium text-gray-800 dark:text-gray-200">{text}</p>
    )}
    {updatedAt && <time class="ml-auto whitespace-nowrap text-xs text-gray-500 dark:text-gray-400" datetime={updatedAt.toISOString()}><FormattedDate date={updatedAt} /></time>}
  </section>
)}
