---
import { SITE_METADATA, NAVIGATION } from "@/consts";
import HeaderLink from "./HeaderLink.astro";
import BasketLogo from "./BasketLogo.astro";
import MobileNav from "./MobileNav.astro";
import ThemeSwitcher from "./ThemeSwitcher.astro";
import SearchDialog from "./SearchDialog.astro";

const visibleNavigation = NAVIGATION.filter((link) => link.href !== "/");
const primaryNavigation = visibleNavigation.slice(0, 3);
const moreNavigation = visibleNavigation.slice(3);
---

<div class="relative mb-20">
  <header data-site-header class="site-header fixed inset-x-0 top-0 z-50 bg-white/75 dark:bg-gray-950/70">
  <div class="mx-auto w-full max-w-3xl px-4 sm:px-6 lg:max-w-6xl lg:px-6 xl:px-0">
    <div class="flex h-16 items-center justify-between">
      <div>
        <a href="/" aria-label={SITE_METADATA.headerTitle}>
          <div class="flex items-center">
            <BasketLogo />
          </div>
        </a>
      </div>
      <div class="mr-1 flex items-center gap-3 sm:gap-4 lg:gap-5">
        <nav aria-label="Main navigation" class="hidden items-center gap-4 lg:flex xl:gap-5">
          {primaryNavigation.map((link) => (
            <HeaderLink href={link.href} class="whitespace-nowrap text-sm font-medium">
              {link.title}
            </HeaderLink>
          ))}
          {moreNavigation.length > 0 && (
            <details class="relative">
              <summary class="cursor-pointer list-none whitespace-nowrap rounded-md px-1 py-2 text-sm font-medium text-gray-700 transition hover:text-primary-700 dark:text-gray-200 dark:hover:text-primary-300">
                More <span aria-hidden="true" class="ml-0.5 text-xs">⌄</span>
              </summary>
              <div class="absolute right-0 top-full z-[70] mt-2 min-w-44 rounded-xl border border-gray-200 bg-white p-2 shadow-xl dark:border-gray-700 dark:bg-gray-900">
                {moreNavigation.map((link) => (
                  <a href={link.href} class="block rounded-lg px-3 py-2 text-sm text-gray-700 transition hover:bg-gray-50 hover:text-primary-700 dark:text-gray-200 dark:hover:bg-gray-800 dark:hover:text-primary-300">{link.title}</a>
                ))}
              </div>
            </details>
          )}
        </nav>
        <SearchDialog />
        <ThemeSwitcher />
        <div class="lg:hidden"><MobileNav /></div>
      </div>
    </div>
    </div>
  </header>
</div>

<script>
  const syncHeader = () => {
    document.querySelector("[data-site-header]")?.setAttribute("data-scrolled", String(window.scrollY > 8));
  };
  window.addEventListener("scroll", syncHeader, { passive: true });
  document.addEventListener("astro:page-load", syncHeader);
  syncHeader();
</script>
