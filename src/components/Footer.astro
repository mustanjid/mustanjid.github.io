---
import SocialLinks from '@/components/SocialLinks.astro'
import {SITE_METADATA, NAVIGATION} from '@/consts'

import Link from "./Link.astro";

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-gray-200/80 pt-10 dark:border-gray-800">
    <div class="grid gap-8 sm:grid-cols-3">
        <div>
            <p class="text-base font-bold text-gray-900 dark:text-gray-100">{SITE_METADATA.headerTitle}</p>
            <p class="mt-2 max-w-xs text-sm leading-6 text-gray-600 dark:text-gray-400">{SITE_METADATA.description}</p>
        </div>
        <nav aria-label="Footer">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400">Site</p>
            <ul class="mt-3 space-y-2 text-sm">
                {NAVIGATION.map(({href, title}) => (
                    <li><Link href={href} class="text-gray-700 hover:text-primary-700 dark:text-gray-300 dark:hover:text-primary-300">{title}</Link></li>
                ))}
                <li><Link href="/rss.xml" class="text-gray-700 hover:text-primary-700 dark:text-gray-300 dark:hover:text-primary-300">RSS</Link></li>
            </ul>
        </nav>
        <div>
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-gray-500 dark:text-gray-400">Elsewhere</p>
            <SocialLinks class="mt-3 flex space-x-4" size={6} />
        </div>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-2 pb-8 text-xs text-gray-500 dark:text-gray-400">
        <p>{`© ${year} ${SITE_METADATA.author}`}</p>
        <p>Dhaka, Bangladesh · <time data-dhaka-clock aria-label="Local time in Dhaka"></time></p>
    </div>
</footer>

<script>
    const tick = () => {
        const el = document.querySelector<HTMLElement>("[data-dhaka-clock]");
        if (el) el.textContent = new Intl.DateTimeFormat("en-GB", {hour: "2-digit", minute: "2-digit", timeZone: "Asia/Dhaka"}).format(new Date()) + " BST";
    };
    tick();
    setInterval(tick, 30000);
    document.addEventListener("astro:page-load", tick);
</script>
