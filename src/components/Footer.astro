---
import SocialLinks from "@/components/SocialLinks.astro";
import BasketLogo from "@/components/BasketLogo.astro";
import { siteData } from "@/data/content";
import { SITE_METADATA, NAVIGATION } from "@/consts";

const year = new Date().getFullYear();
const personalLinks = [
  { title: "About", href: "/about" },
  { title: "CV", href: "/cv" },
  { title: "Achievements", href: "/award" },
];
---

<footer class="mt-16 border-t border-gray-200 pt-8 pb-8 text-sm text-gray-500 dark:border-gray-800 dark:text-gray-400">
  <div class="flex flex-wrap justify-between gap-8">
    <div class="flex max-w-[38ch] flex-col items-start gap-2">
      <a class="footer-brand-logo inline-flex items-center" href="/" aria-label={`${SITE_METADATA.headerTitle}, home`}>
        <BasketLogo />
      </a>
      <p class="m-0 max-w-[36ch] font-light leading-6 text-gray-600 dark:text-gray-300">{siteData.footerText || SITE_METADATA.description}</p>
    </div>

    <nav class="flex flex-wrap gap-x-12 gap-y-6" aria-label="Footer">
      <div class="flex min-w-24 flex-col gap-2">
        <h2 class="mb-1 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400">Site</h2>
        {NAVIGATION.filter(({ href }) => href !== "/").map(({ href, title }) => (
          <a class="transition hover:text-primary-700 dark:hover:text-primary-300" href={href}>{title}</a>
        ))}
        <a class="transition hover:text-primary-700 dark:hover:text-primary-300" href="/rss.xml">RSS feed</a>
      </div>

      <div class="flex min-w-24 flex-col gap-2">
        <h2 class="mb-1 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400">Personal</h2>
        {personalLinks.map(({ href, title }) => (
          <a class="transition hover:text-primary-700 dark:hover:text-primary-300" href={href}>{title}</a>
        ))}
      </div>

      <div class="flex min-w-24 flex-col gap-2">
        <h2 class="mb-1 font-mono text-[11px] font-semibold uppercase tracking-[0.12em] text-gray-500 dark:text-gray-400">Get me on</h2>
        <SocialLinks class="flex flex-col gap-2" size={5} />
      </div>
    </nav>
  </div>

  <div class="mt-8 flex flex-wrap items-center gap-x-4 gap-y-2 border-t border-gray-200 pt-4 text-xs dark:border-gray-800">
    <a href="/" class="font-semibold text-gray-700 hover:text-primary-700 dark:text-gray-200 dark:hover:text-primary-300">{SITE_METADATA.siteUrl.replace(/^https?:\/\//, "").replace(/\/$/, "")}</a>
    <span class="inline-flex items-center gap-2">
      <span class="relative flex h-2 w-2" aria-hidden="true">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-500 opacity-50"></span>
        <span class="relative inline-flex h-2 w-2 rounded-full bg-emerald-500"></span>
      </span>
      <span>Dhaka, Bangladesh</span>
    </span>
    <span class="inline-flex items-center gap-1.5">
      <time data-dhaka-clock aria-label="Local time in Dhaka"></time>
      <span>BST</span>
    </span>
    <span class="ml-auto">© {year} {SITE_METADATA.author}</span>
  </div>
</footer>

<style is="global">
  .footer-brand-logo .mb-logo { height: 1.7rem; width: auto; }
  @media (min-width: 640px) {
    .footer-brand-logo .mb-logo { height: 1.85rem; }
  }
</style>

<script>
  const tick = () => {
    const el = document.querySelector<HTMLElement>("[data-dhaka-clock]");
    if (el) el.textContent = new Intl.DateTimeFormat("en-GB", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Dhaka" }).format(new Date());
  };
  tick();
  window.setInterval(tick, 30000);
  document.addEventListener("astro:page-load", tick);
</script>
