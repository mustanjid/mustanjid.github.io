---
// Card for a research-kind project (Projects page: Latest and Research tabs).
import type { CollectionEntry } from "astro:content";
import { STAGE_LABEL } from "@/functions";
import { pagesData } from "@/data/content";

interface Props {
    project: CollectionEntry<"projects">;
    variant?: "latest" | "list";
}

const { project, variant = "list" } = Astro.props;
const { data, slug } = project;
const isLatest = variant === "latest";
const stage = data.stage ? STAGE_LABEL[data.stage] : undefined;
---

<article class:list={["overflow-hidden rounded-xl border border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-900/50", isLatest && "flex h-full flex-col shadow-sm"]}>
    {data.imgSrc ? (
        <img src={data.imgSrc} alt="" class:list={["w-full object-cover", isLatest ? "h-40 sm:h-44" : "aspect-[3/2]"]} loading="lazy" />
    ) : isLatest && (
        <div class="flex h-40 items-end bg-gradient-to-br from-blue-100 via-indigo-100 to-emerald-100 p-5 dark:from-blue-950 dark:via-indigo-950 dark:to-emerald-950 sm:h-44">
            <span class="text-sm font-bold uppercase tracking-[0.2em] text-primary-800 dark:text-primary-200">{pagesData.projects.tabResearch}</span>
        </div>
    )}
    <div class:list={[isLatest ? "flex flex-1 flex-col items-start p-5" : "p-5"]}>
        <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
            {stage && <span class="rounded-full bg-primary-50 px-3 py-1 font-medium capitalize text-primary-700 dark:bg-primary-950 dark:text-primary-300">{stage}</span>}
            {data.date && <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}</time>}
        </div>
        <h2 class="mt-3 text-xl font-bold leading-6 text-gray-900 dark:text-gray-100">{data.title}</h2>
        {data.description && <p class:list={["mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300", isLatest && "line-clamp-4"]}>{data.description}</p>}
        {!isLatest && data.areas.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-1.5">
                {data.areas.map((area) => <li class="rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">{area}</li>)}
            </ul>
        )}
        <a class:list={["font-semibold text-primary-600 hover:underline dark:text-primary-400", isLatest ? "mt-auto pt-4" : "mt-4 inline-block text-sm"]} href={`/projects/${slug}`}>{pagesData.projects.detailsLabel} <span aria-hidden="true">&rarr;</span></a>
    </div>
</article>
