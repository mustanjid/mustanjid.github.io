---
import { getFeaturedProject, STAGE_LABEL } from "@/functions";
import { pagesData } from "@/data/content";
import type { CollectionEntry } from "astro:content";
import ShareButton from "@/components/ShareButton.astro";

interface Props {
  size?: "default" | "large" | "tile";
  /** Limit to research projects (Research page) or render a separate non-research homepage item. */
  kind?: "research" | "other";
  project?: CollectionEntry<"projects">;
}

const { size = "default", kind, project: projectEntry } = Astro.props;
const isLarge = size === "large";
const isTile = size === "tile";
const entry = projectEntry ?? (kind === "other" ? undefined : await getFeaturedProject(kind));
const articleId = kind === "other" ? "current-development-project" : "current-project";
const project = entry && {
  slug: entry.slug,
  title: entry.data.title,
  stage: entry.data.stage,
  summary: entry.data.description,
  image: entry.data.imgSrc,
  areas: entry.data.areas,
  tools: entry.data.stack,
  repoUrl: entry.data.srccode,
  demoUrl: entry.data.url,
};
const areas = project?.areas ?? [];
const shareUrl = project ? new URL(`/projects/${project.slug}/`, Astro.site).href : "";
const tools = project?.tools ?? [];
const t = pagesData.home;
const chipClass = isTile
  ? "rounded-full bg-primary-50 px-2 py-0.5 text-[11px] font-medium text-primary-800 dark:bg-primary-950 dark:text-primary-200"
  : "rounded-full bg-primary-50 px-2.5 py-1 text-xs font-medium text-primary-800 dark:bg-primary-950 dark:text-primary-200";
---

{project && (
  <article id={articleId} aria-labelledby={`${articleId}-title`} class:list={[
    isLarge
      ? "overflow-hidden rounded-2xl"
      : isTile
        ? "group relative flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:border-primary-300 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900/50 dark:hover:border-primary-700"
        : "relative",
  ]}>
    <div class:list={[
      isTile
        ? "flex flex-1 flex-col"
        : ["grid", isLarge ? "xl:grid-cols-[minmax(16rem,0.9fr)_minmax(0,1.1fr)]" : "xl:grid-cols-[minmax(12rem,0.65fr)_minmax(0,1.35fr)]"],
    ]}>
      <div class:list={[
        isTile
          ? "relative h-32 shrink-0 bg-gradient-to-br from-sky-50 via-indigo-50 to-emerald-50 dark:from-sky-950 dark:via-indigo-950 dark:to-emerald-950 sm:h-36"
          : isLarge
            ? "relative h-40 self-stretch bg-gradient-to-br from-sky-50 via-indigo-50 to-emerald-50 dark:from-sky-950 dark:via-indigo-950 dark:to-emerald-950 sm:h-48 xl:h-auto xl:min-h-48"
            : "relative min-h-28 self-stretch sm:min-h-full",
      ]}>
        {project.image ? (
          <img src={project.image} alt="" class:list={["absolute inset-0 h-full w-full object-center", isTile || isLarge ? "object-contain p-2" : "object-contain"]} loading="lazy" />
        ) : (
          <div role="img" aria-label="Abstract illustration of connected project pathways" class="absolute inset-0 flex items-center justify-center">
            <svg viewBox="0 0 320 220" class="h-32 w-full max-w-sm" fill="none" aria-hidden="true">
              <path d="M56 157 118 105l68 34 78-74M118 105l18-53m50 87 30 55m-98-89-67-35" stroke="currentColor" stroke-width="3" class="text-indigo-400 dark:text-indigo-300" />
              <circle cx="56" cy="157" r="13" fill="currentColor" class="text-sky-500" />
              <circle cx="118" cy="105" r="18" fill="currentColor" class="text-indigo-500" />
              <circle cx="136" cy="52" r="10" fill="currentColor" class="text-emerald-500" />
              <circle cx="186" cy="139" r="13" fill="currentColor" class="text-sky-600" />
              <circle cx="214" cy="191" r="10" fill="currentColor" class="text-emerald-600" />
              <circle cx="264" cy="65" r="15" fill="currentColor" class="text-violet-500" />
              <circle cx="51" cy="70" r="9" fill="currentColor" class="text-teal-500" />
            </svg>
          </div>
        )}
      </div>
      <div class:list={[isLarge ? "p-5 sm:p-6" : isTile ? "flex flex-1 flex-col p-4 sm:p-5" : "p-4 sm:p-5"]}>
        <div class:list={["flex flex-wrap items-center gap-1 font-bold uppercase tracking-wide text-primary-700 dark:text-primary-300", isTile ? "text-xs" : "text-sm"]}>
          <span>{kind === "other" ? t.currentDevProjectEyebrow : t.currentProjectEyebrow}</span>
          {project.stage && <><span aria-hidden="true">·</span><span>{STAGE_LABEL[project.stage]}</span></>}
        </div>
        <h2 id={`${articleId}-title`} class:list={[
          isTile
            ? "mt-1 text-lg font-extrabold leading-6 text-gray-900 dark:text-gray-100"
            : "mt-1 text-base font-extrabold leading-6 text-gray-900 dark:text-gray-100 sm:text-lg",
        ]}>{project.title}</h2>
        {project.summary && <p class:list={[
          isTile
            ? "mt-2 line-clamp-2 text-sm leading-5 text-gray-600 dark:text-gray-300"
            : "mt-2 text-xs leading-5 text-gray-600 dark:text-gray-300 sm:text-sm",
        ]}>{project.summary}</p>}

        {areas.length > 0 && (
          <div class:list={["mt-3 flex flex-wrap items-center gap-2", isTile && "mt-2"]}>
            <h3 class:list={[isTile ? "text-xs" : "text-sm", "font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400"]}>{t.areasLabel}</h3>
            <ul class="flex flex-wrap gap-1.5">{areas.map((item) => <li class={chipClass}>{item}</li>)}</ul>
          </div>
        )}
        {tools.length > 0 && !isTile && (
          <div class="mt-2 flex flex-wrap items-center gap-2">
            <h3 class:list={[isTile ? "text-xs" : "text-sm", "font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400"]}>{t.toolsLabel}</h3>
            <ul class="flex flex-wrap gap-1.5">{tools.map((item) => <li class={chipClass}>{item}</li>)}</ul>
          </div>
        )}

        <div class:list={["mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-semibold", isTile && "mt-auto pt-4"]}>
          <a
            class:list={[
              isLarge
                ? "inline-flex items-center gap-1 rounded-lg bg-primary-700 px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 dark:bg-primary-500 dark:text-gray-950 dark:hover:bg-primary-400"
                : isTile
                  ? "relative inline-flex items-center gap-1 rounded-lg bg-primary-700 px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition group-hover:bg-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 dark:bg-primary-500 dark:text-gray-950 dark:group-hover:bg-primary-400 after:absolute after:inset-0 after:content-['']"
                  : "inline-flex items-center gap-1 rounded-lg bg-primary-700 px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 dark:bg-primary-500 dark:text-gray-950 dark:hover:bg-primary-400 after:absolute after:inset-0 after:content-['']",
            ]}
            href={`/projects/${project.slug}`}
          >
            {t.projectDetailsLabel} <span aria-hidden="true">&rarr;</span>
          </a>
          {isLarge && project.repoUrl && <a class="text-primary-700 hover:underline dark:text-primary-300" href={project.repoUrl} target="_blank" rel="noopener noreferrer">{t.repositoryLabel}</a>}
          {isLarge && project.demoUrl && <a class="text-primary-700 hover:underline dark:text-primary-300" href={project.demoUrl} target="_blank" rel="noopener noreferrer">{t.implementationLabel}</a>}
          {isLarge && <span class="relative"><ShareButton url={shareUrl} title={project.title} text={project.summary} label={pagesData.projects.shareLabel} /></span>}
        </div>
      </div>
    </div>
  </article>
)}
