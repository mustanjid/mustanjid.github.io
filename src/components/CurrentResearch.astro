---
import { getFeaturedProject, STAGE_LABEL } from "@/functions";
import { pagesData } from "@/data/content";
import type { CollectionEntry } from "astro:content";
import ShareButton from "@/components/ShareButton.astro";
import WorkStamp from "@/components/WorkStamp.astro";

interface Props {
  size?: "default" | "large" | "tile";
  /** Limit to research projects (Research page) or render a separate non-research homepage item. */
  kind?: "research" | "other";
  project?: CollectionEntry<"projects">;
}

const { size = "default", kind, project: projectEntry } = Astro.props;
const isLarge = size === "large";
const isTile = size === "tile";
const entry = projectEntry ?? (kind === "other" ? undefined : await getFeaturedProject(kind));
const articleId = kind === "other" ? "current-development-project" : "current-project";
const project = entry && {
  slug: entry.slug,
  title: entry.data.title,
  stage: entry.data.stage,
  summary: entry.data.description,
  image: entry.data.imgSrc,
  areas: entry.data.areas,
  tools: entry.data.stack,
  repoUrl: entry.data.srccode,
  demoUrl: entry.data.url,
};
const areas = project?.areas ?? [];
const shareUrl = project ? new URL(`/projects/${project.slug}/`, Astro.site).href : "";
const tools = project?.tools ?? [];
const t = pagesData.home;
const chipClass = "rounded-md bg-primary-50 px-2 py-0.5 text-xs font-medium text-primary-800 dark:bg-primary-950 dark:text-primary-200";
const toolLimit = isTile ? 4 : 8;
const shownTools = tools.slice(0, toolLimit);
const moreTools = tools.length - shownTools.length;
---

{project && (
  <article id={articleId} aria-labelledby={`${articleId}-title`} class:list={[
    isLarge
      ? "group relative overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:border-primary-300 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900/50 dark:hover:border-primary-700"
      : isTile
        ? "group relative flex h-full flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:border-primary-300 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900/50 dark:hover:border-primary-700"
        : "relative",
  ]}>
    <div class:list={[
      isTile
        ? "flex flex-1 flex-col"
        : ["grid", isLarge ? "xl:grid-cols-[minmax(16rem,0.9fr)_minmax(0,1.1fr)]" : "xl:grid-cols-[minmax(12rem,0.65fr)_minmax(0,1.35fr)]"],
    ]}>
      <div class:list={["relative p-3", isTile ? "shrink-0 pb-0" : "self-stretch"]}>
        <WorkStamp />
        <div class="overflow-hidden rounded-xl border border-gray-200 bg-gray-50 dark:border-gray-800 dark:bg-gray-950">
          {kind === "other" && (
            <div class="flex items-center gap-1.5 border-b border-gray-200 bg-white px-3 py-2 dark:border-gray-800 dark:bg-gray-900" aria-hidden="true">
              <span class="h-2 w-2 rounded-full bg-rose-400"></span><span class="h-2 w-2 rounded-full bg-amber-400"></span><span class="h-2 w-2 rounded-full bg-emerald-400"></span>
            </div>
          )}
          <div class:list={["aspect-video overflow-hidden", !isTile && !isLarge && "min-h-28"]}>
            {project.image ? (
              <img src={project.image} alt="" class:list={["h-full w-full transition-transform duration-500 group-hover:scale-[1.03]", kind === "other" ? "object-cover object-top" : "bg-white object-contain p-2"]} loading="lazy" />
            ) : (
              <div role="img" aria-label="Abstract illustration of connected project pathways" class="flex h-full items-center justify-center">
                <svg viewBox="0 0 320 220" class="h-32 w-full max-w-sm" fill="none" aria-hidden="true">
                  <path d="M56 157 118 105l68 34 78-74M118 105l18-53m50 87 30 55m-98-89-67-35" stroke="currentColor" stroke-width="3" class="text-primary-400 dark:text-primary-300" />
                  <circle cx="56" cy="157" r="13" fill="currentColor" class="text-sky-500" />
                  <circle cx="118" cy="105" r="18" fill="currentColor" class="text-primary-500" />
                  <circle cx="136" cy="52" r="10" fill="currentColor" class="text-emerald-500" />
                  <circle cx="186" cy="139" r="13" fill="currentColor" class="text-sky-600" />
                  <circle cx="214" cy="191" r="10" fill="currentColor" class="text-emerald-600" />
                  <circle cx="264" cy="65" r="15" fill="currentColor" class="text-teal-500" />
                </svg>
              </div>
            )}
          </div>
        </div>
      </div>
      <div class:list={[isLarge ? "p-5 sm:p-6" : isTile ? "flex flex-1 flex-col p-4 sm:p-5" : "p-4 sm:p-5"]}>
        <div class:list={["flex flex-wrap items-center gap-1 font-bold uppercase tracking-wide text-primary-700 dark:text-primary-300", isTile ? "text-sm" : "text-base"]}>
          <span>{kind === "other" ? t.currentDevProjectEyebrow : t.currentProjectEyebrow}</span>
          {project.stage && <><span aria-hidden="true">·</span><span>{STAGE_LABEL[project.stage]}</span></>}
        </div>
        <h2 id={`${articleId}-title`} class:list={[
          isTile
            ? "mt-1 text-lg font-extrabold leading-6 text-gray-900 dark:text-gray-100"
            : "mt-1 text-base font-extrabold leading-6 text-gray-900 dark:text-gray-100 sm:text-lg",
        ]}>{project.title}</h2>
        {project.summary && <p class:list={[
          isTile
            ? "mt-2 line-clamp-2 text-sm leading-5 text-gray-600 dark:text-gray-300"
            : "mt-2 text-xs leading-5 text-gray-600 dark:text-gray-300 sm:text-sm",
        ]}>{project.summary}</p>}

        {shownTools.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-1.5" aria-label={t.toolsLabel}>
            {shownTools.map((item) => <li class={chipClass}>{item}</li>)}
            {moreTools > 0 && <li class="rounded-md bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-600 dark:bg-gray-800 dark:text-gray-300">+{moreTools}</li>}
          </ul>
        )}
        {areas.length > 0 && (
          <p class="mt-2 text-xs leading-5 text-gray-500 dark:text-gray-400"><span class="font-semibold uppercase tracking-wide">{t.areasLabel}:</span>{` ${areas.slice(0, 4).join(" · ")}`}</p>
        )}

        <div class:list={["mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-semibold", isTile && "mt-auto pt-4"]}>
          <a
            class:list={[
              isLarge
                ? "inline-flex items-center gap-1 rounded-lg bg-primary-700 px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition group-hover:bg-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 dark:bg-primary-500 dark:text-gray-950 dark:group-hover:bg-primary-400 after:absolute after:inset-0 after:content-['']"
                : isTile
                  ? "inline-flex items-center gap-1 rounded-lg bg-primary-700 px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition group-hover:bg-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 dark:bg-primary-500 dark:text-gray-950 dark:group-hover:bg-primary-400 after:absolute after:inset-0 after:content-['']"
                  : "inline-flex items-center gap-1 rounded-lg bg-primary-700 px-3 py-1.5 text-sm font-semibold text-white shadow-sm transition hover:bg-primary-800 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-700 dark:bg-primary-500 dark:text-gray-950 dark:hover:bg-primary-400 after:absolute after:inset-0 after:content-['']",
            ]}
            href={`/projects/${project.slug}`}
          >
            {t.projectDetailsLabel} <span aria-hidden="true">&rarr;</span>
          </a>
          {isLarge && project.repoUrl && <a class="relative z-10 text-primary-700 hover:underline dark:text-primary-300" href={project.repoUrl} target="_blank" rel="noopener noreferrer">{t.repositoryLabel}</a>}
          {isLarge && project.demoUrl && <a class="relative z-10 text-primary-700 hover:underline dark:text-primary-300" href={project.demoUrl} target="_blank" rel="noopener noreferrer">{t.implementationLabel}</a>}
          {isLarge && <span class="relative z-10"><ShareButton url={shareUrl} label={pagesData.projects.shareLabel} /></span>}
        </div>
      </div>
    </div>
  </article>
)}
