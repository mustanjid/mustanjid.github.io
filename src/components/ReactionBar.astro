---
import { getReactionConfig, reactionItemId } from "@/reactions";

interface Props {
  id: string;
  /** Icon + count only, for cards and list rows. */
  compact?: boolean;
}

const { id, compact = false } = Astro.props;
const { available, demo, url, key, icon } = getReactionConfig();
const isHeart = icon === "heart";
const label = isHeart ? "Love" : "Like";

const button = [
  "inline-flex items-center gap-1.5 rounded-full border border-gray-300 bg-white font-semibold text-gray-700 transition",
  "hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500 disabled:opacity-60",
  "dark:border-gray-700 dark:bg-transparent dark:text-gray-200 dark:hover:bg-gray-800",
  compact ? "min-h-8 min-w-8 justify-center px-2.5 py-1 text-xs" : "min-h-10 min-w-10 justify-center px-3.5 py-1.5 text-sm",
  isHeart
    ? "aria-pressed:border-rose-500 aria-pressed:bg-rose-50 aria-pressed:text-rose-600 dark:aria-pressed:border-rose-400 dark:aria-pressed:bg-rose-950/40 dark:aria-pressed:text-rose-300"
    : "aria-pressed:border-primary-600 aria-pressed:bg-primary-50 aria-pressed:text-primary-700 dark:aria-pressed:border-primary-400 dark:aria-pressed:bg-primary-950 dark:aria-pressed:text-primary-200",
];
const iconSize = compact ? 14 : 20;
---

{available && (
  // Hidden until the count loads; stays hidden if the counter service can't be reached or JavaScript is off.
  <div data-reactions hidden data-reaction-id={reactionItemId(id)} data-endpoint={url} data-key={key} data-demo={demo ? "1" : undefined}>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" data-reaction="like" aria-pressed="false" aria-label={label} title={label} class:list={button}>
        {isHeart ? (
          <svg xmlns="http://www.w3.org/2000/svg" height={iconSize} width={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20.5s-8-4.9-8-11A4.6 4.6 0 0 1 12 6.6 4.6 4.6 0 0 1 20 9.5c0 6.1-8 11-8 11z" /></svg>
        ) : (
          <svg xmlns="http://www.w3.org/2000/svg" height={iconSize} width={iconSize} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 10v11" /><path d="M14 5.9 13 10h5.8a2 2 0 0 1 1.95 2.45l-1.4 6.5A2 2 0 0 1 17.4 20.5H7V10l3.6-6.3a1.7 1.7 0 0 1 3.4 1.2z" /></svg>
        )}
        <span data-reaction-count class="tabular-nums"></span>
      </button>
      {demo && <span class="text-[11px] font-medium text-amber-600 dark:text-amber-400">Demo only: not connected yet</span>}
      <span data-reaction-status role="status" aria-live="polite" class="sr-only"></span>
    </div>
  </div>
)}

<style>
  button[aria-pressed="true"] svg {
    fill: currentColor;
  }
</style>

<script>
  // Delegated, document-level listeners so the buttons keep working after Astro View Transitions swap the page.
  type Kind = "like"; // the single reaction (shown as a heart or a thumbs-up)
  type Totals = { like: number };

  const w = window as unknown as { __reactionsReady?: boolean };
  const MINE = "reactions:v1"; // this visitor's own choice per item (kept in this browser only)
  const DEMO = "reactions:demo:v1"; // fake counts used by `npm run dev` when nothing is connected
  const KINDS: Kind[] = ["like"];
  const totals: Record<string, Totals> = {};

  const readJson = <T,>(name: string, fallback: T): T => {
    try {
      return JSON.parse(localStorage.getItem(name) ?? "") as T;
    } catch {
      return fallback;
    }
  };
  const writeJson = (name: string, value: unknown) => {
    try {
      localStorage.setItem(name, JSON.stringify(value));
    } catch {
      /* private mode: the reaction still counts, it just isn't remembered */
    }
  };

  const bars = () => [...document.querySelectorAll<HTMLElement>("[data-reactions]")];
  const totalsFor = (id: string): Totals => (totals[id] ??= { like: 0 });

  const paint = (bar: HTMLElement) => {
    const id = bar.dataset.reactionId ?? "";
    const mine = readJson<Record<string, string>>(MINE, {})[id];
    KINDS.forEach((kind) => {
      const button = bar.querySelector<HTMLElement>(`[data-reaction="${kind}"]`);
      if (!button) return;
      button.setAttribute("aria-pressed", String(mine === kind));
      const count = button.querySelector<HTMLElement>("[data-reaction-count]");
      const value = totalsFor(id)[kind];
      if (count) count.textContent = value > 0 ? String(value) : "";
    });
  };
  const paintAll = (id?: string) => bars().filter((bar) => !id || bar.dataset.reactionId === id).forEach(paint);

  const headers = (key: string): Record<string, string> => {
    const base: Record<string, string> = { apikey: key, "Content-Type": "application/json" };
    // legacy "anon" keys are JWTs and also go in Authorization; new "publishable" keys are not JWTs and must not
    if (key.split(".").length === 3) base.Authorization = `Bearer ${key}`;
    return base;
  };

  const loadTotals = async () => {
    const list = bars();
    if (list.length === 0) return;
    const ids = [...new Set(list.map((bar) => bar.dataset.reactionId ?? ""))].filter(Boolean);
    const { endpoint = "", key = "" } = list[0].dataset;

    ids.forEach((id) => (totals[id] = { like: 0 }));
    try {
      if (!endpoint) {
        const demo = readJson<Record<string, Totals>>(DEMO, {});
        ids.forEach((id) => (totals[id] = { like: demo[id]?.like ?? 0 }));
      } else {
        for (let i = 0; i < ids.length; i += 40) {
          const chunk = ids.slice(i, i + 40);
          const query = new URLSearchParams({ select: "item_id,kind,total", item_id: `in.(${chunk.map((id) => `"${id}"`).join(",")})` });
          const response = await fetch(`${endpoint}/rest/v1/reactions?${query}`, { headers: headers(key) });
          if (!response.ok) throw new Error(String(response.status));
          const rows = (await response.json()) as { item_id: string; kind: Kind; total: number }[];
          rows.forEach((row) => {
            if (row.kind === "like") totals[row.item_id].like = Number(row.total) || 0;
          });
        }
      }
      list.forEach((bar) => {
        bar.hidden = false;
        paint(bar);
      });
    } catch {
      list.forEach((bar) => (bar.hidden = true)); // counter unreachable: show nothing rather than dead buttons
    }
  };

  const save = async (bar: HTMLElement, id: string, from: Kind | undefined, to: Kind | undefined) => {
    const { endpoint = "", key = "" } = bar.dataset;
    if (!endpoint) {
      const demo = readJson<Record<string, Totals>>(DEMO, {});
      demo[id] = { ...totalsFor(id) };
      writeJson(DEMO, demo);
      return;
    }
    const response = await fetch(`${endpoint}/rest/v1/rpc/react`, {
      method: "POST",
      headers: headers(key),
      body: JSON.stringify({ p_item: id, p_from: from ?? null, p_to: to ?? null }),
    });
    if (!response.ok) throw new Error(String(response.status));
  };

  if (!w.__reactionsReady) {
    w.__reactionsReady = true;

    document.addEventListener("click", async (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-reaction]");
      const bar = button?.closest<HTMLElement>("[data-reactions]");
      if (!button || !bar || bar.dataset.busy === "1") return;

      const id = bar.dataset.reactionId ?? "";
      const mine = readJson<Record<string, Kind>>(MINE, {});
      const before: Kind | undefined = mine[id] === "like" ? "like" : undefined;
      const after: Kind | undefined = before ? undefined : "like"; // tapping again removes it

      const snapshot = { ...totalsFor(id) };
      const current = totalsFor(id);
      if (before) current[before] = Math.max(0, current[before] - 1);
      if (after) current[after] += 1;
      if (after) mine[id] = after;
      else delete mine[id];
      writeJson(MINE, mine);
      paintAll(id);

      bar.dataset.busy = "1"; // one request at a time per bar
      try {
        await save(bar, id, before, after);
      } catch {
        totals[id] = snapshot; // the server said no: put everything back
        const restored = readJson<Record<string, Kind>>(MINE, {});
        if (before) restored[id] = before;
        else delete restored[id];
        writeJson(MINE, restored);
        paintAll(id);
        const status = bar.querySelector<HTMLElement>("[data-reaction-status]");
        if (status) {
          status.textContent = "Could not save your reaction. Please try again.";
          window.setTimeout(() => (status.textContent = ""), 3000);
        }
      } finally {
        delete bar.dataset.busy;
      }
    });

    document.addEventListener("astro:page-load", loadTotals);
  }
  loadTotals();
</script>
