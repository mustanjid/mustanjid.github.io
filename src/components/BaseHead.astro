---
import { siteData } from "@/data/content";
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '@/styles/global.css';
import {SITE_METADATA} from "@/consts";
import {ViewTransitions} from 'astro:transitions';
import {FALLBACK_OG_IMAGE, OG_HEIGHT, OG_WIDTH, ogImagePath} from "@/og";

interface Props {
  title: string;
  description?: string;
  /** Link-preview image for this page (site-relative or absolute). Falls back to the site-wide preview image. */
  image?: string;
  imageAlt?: string;
  type?: "website" | "article";
  /** ISO date; only used for type="article". */
  publishedTime?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const toAbsolute = (src: string) => (/^https?:\/\//.test(src) ? src : new URL(src, Astro.site).href);

const {title, description: pageDescription, image, imageAlt, type = "website", publishedTime} = Astro.props;
const description = pageDescription?.trim() || siteData.description;
// Prefer the re-encoded 1200x630 JPEG; a page with no (or a missing) image falls back to the site-wide default.
const ogPath = ogImagePath(image) ?? ogImagePath(siteData.ogImage) ?? ogImagePath(FALLBACK_OG_IMAGE) ?? siteData.ogImage;
const ogImage = toAbsolute(ogPath);
const isGeneratedImage = ogPath.startsWith("/og/");
const ogImageAlt = imageAlt?.trim() || title;
---

<head>
    <!-- Global Metadata -->
    <meta charset="utf-8" lang={SITE_METADATA.language}/>
    <meta name="viewport" content="width=device-width,initial-scale=1"/>
    <!-- <link rel="icon" type="image/svg+xml" href="/favicon.svg"/> -->
    <meta name="generator" content={Astro.generator}/>

    <!-- Font preloads -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Bengali:wght@400;500;600;700&family=Space+Grotesk:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" crossorigin>
    <!--<link rel="preload" href="/fonts/atkinson-regular.woff" as="font" type="font/woff" crossorigin />-->
    <!--<link rel="preload" href="/fonts/atkinson-bold.woff" as="font" type="font/woff" crossorigin />-->

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL}/>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="description" content={description}/>

    <!-- Open Graph / Facebook / LinkedIn / WhatsApp -->
    <meta property="og:type" content={type}/>
    <meta property="og:site_name" content={siteData.title}/>
    <meta property="og:locale" content="en_US"/>
    <meta property="og:url" content={canonicalURL}/>
    <meta name="title" property="og:title" content={title}/>
    <meta name="description" property="og:description" content={description}/>
    <meta name="image" property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    {isGeneratedImage && <meta property="og:image:type" content="image/jpeg" />}
    {isGeneratedImage && <meta property="og:image:width" content={String(OG_WIDTH)} />}
    {isGeneratedImage && <meta property="og:image:height" content={String(OG_HEIGHT)} />}
    <meta property="og:image:alt" content={ogImageAlt} />
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime}/>}

    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalURL}/>
    <meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/>
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicons -->
    <link rel="apple-touch-icon" sizes="76x76" href="/static/favicons/apple-touch-icon.png"/>
    <link rel="icon" type="image/png" sizes="32x32" href="/static/favicons/favicon-32x32.png"/>
    <link rel="icon" type="image/png" sizes="16x16" href="/static/favicons/favicon-16x16.png"/>
    <link rel="manifest" href="/static/favicons/site.webmanifest"/>
    <link rel="mask-icon" href="/static/favicons/safari-pinned-tab.svg" color="#5bbad5"/>
    <meta name="msapplication-TileColor" content="#000000"/>
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fff"/>
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#000"/>
    <link rel="alternate" type="application/rss+xml" href="/rss.xml"/>

    <style>
      
    </style>

    <ViewTransitions/>
</head>
