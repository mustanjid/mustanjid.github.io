---
import { pagesData } from "@/data/content";
import {type Page, type CollectionEntry} from "astro:content";

import Link from "../components/Link.astro";
import Pagination from "../components/Pagination.astro";
import RootLayout from "./RootLayout.astro";
import Tag from "../components/Tag.astro";
import FormattedDate from "../components/FormattedDate.astro";
import ThoughtsTopicFilter from "../components/ThoughtsTopicFilter.astro";

interface Props {
    title: string;
    description: string;
    page: Page<CollectionEntry<'blog'>[]>;
}

const {title, description, page} = Astro.props;
const hasDefaultSlot = Astro.slots.has('default');
const isBlogPage = Astro.url.pathname.startsWith('/blog');
const posts = page.data.map((post) => ({
    ...post,
    hasBengali: /[\u0980-\u09FF]/.test(`${post.data.title} ${post.data.summary ?? ""}`),
}));
---
<RootLayout title={pagesData.thoughts.seoTitle} description={description ?? pagesData.thoughts.seoDescription}>
    <div class="divide-y divide-gray-200 dark:divide-gray-700">
        <!-- <div class="pb-6 pt-6">
            <h3 class="text-2xl font-extrabold leading-9 tracking-tight text-gray-900 dark:text-gray-100 sm:text-2xl sm:leading-10 md:text-4xl md:leading-14">
                {"title"}
            </h3>
            {hasDefaultSlot && (
                    <div class="prose dark:prose-invert py-4">
                        <slot/>
                    </div>
            )}
        </div> -->

        <div class="flex flex-wrap items-end justify-between gap-4 space-y-1 pb-4 pt-1">
            <div>
                <h1 class="text-2xl font-extrabold leading-8 tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl sm:leading-9 md:text-3xl">
                    {isBlogPage ? pagesData.thoughts.title : title}
                </h1>
                <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">
                    {pagesData.thoughts.subtitle}
                </p>
            </div>
        </div>

        <ThoughtsTopicFilter />
        <div class="pt-4">
            <div>
                <ul class="grid gap-5 sm:grid-cols-2">
                    {posts.map(({slug, data: {date, title, summary, tags, images}, hasBengali}) => (
                        <li class="min-w-0">
                            <article class="flex h-full flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:border-primary-300 dark:border-gray-800 dark:bg-gray-900/50 dark:hover:border-primary-800">
                                {images && (
                                    <Link href={`/blog/${slug}`} aria-label={`Read "${title}"`}>
                                        <img src={images} alt="" class="aspect-[16/9] w-full object-cover" loading="lazy" />
                                    </Link>
                                )}
                                <div class="flex flex-1 flex-col p-5">
                                    <dl>
                                        <dt class="sr-only">Published on</dt>
                                        <dd class="text-sm font-medium leading-5 text-gray-500 dark:text-gray-400">
                                            <FormattedDate date={date}/>
                                        </dd>
                                    </dl>
                                    <h3 class="mt-2 text-xl font-bold leading-7 tracking-tight">
                                        <Link href={`/blog/${slug}`} class:list={["text-gray-900 hover:text-primary-700 dark:text-gray-100 dark:hover:text-primary-300", hasBengali && "font-bengali"]}>
                                            {title}
                                        </Link>
                                    </h3>
                                    <div class="flex flex-wrap gap-y-2 pt-3">
                                        {tags.map(({slug}) => <Tag slug={slug}/>)}
                                    </div>
                                    {summary && <p class:list={["mt-3 line-clamp-3 text-sm leading-6 text-gray-600 dark:text-gray-300", hasBengali && "font-bengali"]}>{summary}</p>}
                                    <Link
                                        href={`/blog/${slug}`}
                                        class="mt-auto inline-flex pt-4 text-sm font-semibold text-primary-700 hover:underline dark:text-primary-300"
                                        aria-label={`Read "${title}"`}
                                    >
                                        {pagesData.thoughts.readMoreLabel} <span class="ml-1" aria-hidden="true">&rarr;</span>
                                    </Link>
                                </div>
                            </article>
                        </li>
                    ))}
                </ul>
                {(page.url.next || page.url.prev) && (
                        <Pagination page={page}/>)}
            </div>
        </div>
    </div>
</RootLayout>
