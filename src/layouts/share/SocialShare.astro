---
import FacebookShareButton from "./Facebook.astro";
import HackerNewsShareButton from "./HackerNews.astro";
import LinkedInShareButton from "./LinkedIn.astro";
import RedditShareButton from "./Reddit.astro";
import TwitterShareButton from "./Twitter.astro";
import CopyLink from "./CopyLink.astro";
import NativeShare from "./NativeShare.astro";
import WhatsAppShare from "./WhatsAppShare.astro";
import ShareHandler from "@/components/ShareHandler.astro";
import type ButtonProps from "./types";

interface Props extends ButtonProps {
  buttons?: any[];
}

const DEFAULT_COMPONENTS = [NativeShare, CopyLink, FacebookShareButton, WhatsAppShare, LinkedInShareButton, TwitterShareButton, RedditShareButton, HackerNewsShareButton];

// Always share the canonical https://mustanjid.github.io/... address, never a localhost, hash or query variant.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const { buttons = DEFAULT_COMPONENTS, url = canonical, title, description, via } = Astro.props;
---

<div data-share-root class="mb-3 mt-6 flex flex-wrap items-center gap-x-4 gap-y-3">
  <div class="text-base font-bold">Share on:</div>
  {buttons.map((Button) => <Button url={url} title={title} />)}
  <span data-share-status role="status" aria-live="polite" class="text-sm font-medium text-primary-700 dark:text-primary-300"></span>
</div>

<ShareHandler />
