---
import RootLayout from "@/layouts/RootLayout.astro";
import { getResearchEntries } from "@/functions";

export async function getStaticPaths() {
    const entries = await getResearchEntries();
    return entries.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { data } = entry;
---

<RootLayout title={`${data.title} | Research Projects`} description={data.summary}>
    <article class="mx-auto max-w-4xl py-8">
        <a href="/projects" class="text-sm font-semibold text-primary-600 hover:underline dark:text-primary-400">&larr; All projects</a>
        {data.image && <img src={data.image} alt="" class="mt-6 max-h-64 w-full rounded-xl object-cover" />}

        <header class="mt-8 border-b border-gray-200 pb-6 dark:border-gray-700">
            <p class="text-sm font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">Research project</p>
            <h1 class="mt-2 text-3xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100 sm:text-4xl">{data.title}</h1>
            <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
                <span class="rounded-full bg-primary-50 px-3 py-1 font-medium capitalize text-primary-700 dark:bg-primary-950 dark:text-primary-300">{data.status.replace("-", " ")}</span>
                {data.date && <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}</time>}
                {data.venue && <span>{data.venue}</span>}
            </div>
        </header>

        <section class="prose prose-lg mt-8 max-w-none dark:prose-invert" aria-labelledby="research-overview">
            <h2 id="research-overview">Overview</h2>
            <p>{data.summary || "Details for this research project will be added soon."}</p>
        </section>

        <dl class="mt-8 grid gap-4 border-t border-gray-200 pt-6 sm:grid-cols-[10rem_minmax(0,1fr)] dark:border-gray-700">
            <dt class="font-semibold text-gray-700 dark:text-gray-200">Researchers</dt>
            <dd class="text-gray-600 dark:text-gray-300">{data.authors}</dd>
            {data.publicationType && <><dt class="font-semibold text-gray-700 dark:text-gray-200">Type</dt><dd class="capitalize text-gray-600 dark:text-gray-300">{data.publicationType}</dd></>}
            {data.publisher && <><dt class="font-semibold text-gray-700 dark:text-gray-200">Publisher</dt><dd class="text-gray-600 dark:text-gray-300">{data.publisher}</dd></>}
            {data.citationDetails && <><dt class="font-semibold text-gray-700 dark:text-gray-200">Publication details</dt><dd class="text-gray-600 dark:text-gray-300">{data.citationDetails}</dd></>}
        </dl>

        {data.tags.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Research topics">
                {data.tags.map((tag) => <li class="rounded-full bg-gray-100 px-3 py-1.5 text-sm font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-200">{tag}</li>)}
            </ul>
        )}

        <nav class="mt-8 flex flex-wrap gap-3" aria-label="Research project links">
            {data.url && <a class="rounded-md bg-primary-700 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-800" href={data.url} target="_blank" rel="noopener noreferrer">Publication</a>}
            {data.preprintUrl && <a class="rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800" href={data.preprintUrl} target="_blank" rel="noopener noreferrer">Preprint</a>}
            {data.pdfUrl && <a class="rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800" href={data.pdfUrl} target="_blank" rel="noopener noreferrer">PDF</a>}
            {data.projectUrl && <a class="rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800" href={data.projectUrl} target="_blank" rel="noopener noreferrer">Project</a>}
            {data.codeUrl && <a class="rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800" href={data.codeUrl} target="_blank" rel="noopener noreferrer">Code</a>}
            {data.datasetUrl && <a class="rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800" href={data.datasetUrl} target="_blank" rel="noopener noreferrer">Dataset</a>}
        </nav>
    </article>
</RootLayout>
