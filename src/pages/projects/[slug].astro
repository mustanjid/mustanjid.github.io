---
import RootLayout from "@/layouts/RootLayout.astro";
import { getProjects, getProjectCategoryName, STAGE_LABEL } from "@/functions";
import { getEntry } from "astro:content";
import { pagesData } from "@/data/content";
import { shareImageSource } from "@/og";
import SocialShare from "@/layouts/share/SocialShare.astro";
import ReactionBar from "@/components/ReactionBar.astro";
import PaperDialog from "@/components/PaperDialog.astro";

export async function getStaticPaths() {
    const projects = await getProjects();
    return projects.map((entry) => ({
        params: { slug: entry.slug },
        props: { entry },
    }));
}

const t = pagesData.projects;
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const hasBody = entry.body.trim().length > 0;
const categoryName = await getProjectCategoryName(data.kind);
const paper = data.paper ? await getEntry(data.paper) : undefined;
const stage = data.stage ? STAGE_LABEL[data.stage] : undefined;
const btnPrimary = "rounded-md bg-primary-700 px-4 py-2 text-sm font-semibold text-white hover:bg-primary-800";
const btn = "rounded-md border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-800";
const paperMeta = paper ? [paper.data.venue, paper.data.date?.getFullYear()].filter(Boolean).join(" · ") : "";
const chip = "rounded-full bg-primary-50 px-3 py-1.5 text-sm font-medium text-primary-800 dark:bg-primary-950 dark:text-primary-200";
---

<RootLayout title={`${data.title} | ${t.title}`} description={data.description} image={shareImageSource(data.imgSrc, data.sharePreview)} imageAlt={data.title}>
    <article class="mx-auto max-w-4xl py-8">
        <a href="/projects" class="text-sm font-semibold text-primary-600 hover:underline dark:text-primary-400">&larr; {t.backLabel}</a>
        {data.imgSrc && <img src={data.imgSrc} alt="" class="mx-auto mt-6 h-auto max-h-[32rem] w-full rounded-xl object-contain" />}

        <header class="mt-8 border-b border-gray-200 pb-6 dark:border-gray-700">
            <p class="text-sm font-semibold uppercase tracking-wide text-primary-600 dark:text-primary-400">{categoryName}</p>
            <h1 class="mt-2 text-2xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl">{data.title}</h1>
            {(stage || data.date) && (
                <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
                    {stage && <span class="rounded-full bg-primary-50 px-3 py-1 font-medium text-primary-700 dark:bg-primary-950 dark:text-primary-300">{stage}</span>}
                    {data.date && <time datetime={data.date.toISOString()}>{data.date.toLocaleDateString("en-US", { month: "long", year: "numeric" })}</time>}
                </div>
            )}
        </header>

        <section class="prose mt-6 max-w-none dark:prose-invert prose-h2:mb-2 prose-h2:mt-0 prose-h2:text-xl prose-p:mt-0 prose-p:mb-3" aria-labelledby="project-overview">
            <h2 id="project-overview">{t.overviewLabel}</h2>
            <p>{data.description}</p>
            {hasBody && <Content />}
        </section>

        {data.areas.length > 0 && (
            <section class="mt-8" aria-labelledby="project-areas">
                <h2 id="project-areas" class="text-xl font-bold text-gray-900 dark:text-gray-100">{t.areasLabel}</h2>
                <ul class="mt-3 flex flex-wrap gap-2">{data.areas.map((item) => <li class={chip}>{item}</li>)}</ul>
            </section>
        )}

        {data.stack.length > 0 && (
            <section class="mt-8" aria-labelledby="project-tools">
                <h2 id="project-tools" class="text-xl font-bold text-gray-900 dark:text-gray-100">{t.toolsLabel}</h2>
                <ul class="mt-3 flex flex-wrap gap-2">{data.stack.map((item) => <li class={chip}>{item}</li>)}</ul>
            </section>
        )}

        {paper && (
            <section class="mt-8" aria-labelledby="project-paper">
                <h2 id="project-paper" class="text-xl font-bold text-gray-900 dark:text-gray-100">{t.paperLabel}</h2>
                <div class="mt-3 rounded-xl border border-gray-200 p-4 dark:border-gray-800">
                    <h3 class="text-base font-semibold leading-6 text-gray-900 dark:text-gray-100">
                        <button type="button" data-paper-open={`details-${paper.slug}`} aria-haspopup="dialog" aria-controls={`details-${paper.slug}`} class="text-left hover:text-primary-700 dark:hover:text-primary-300">{paper.data.title}</button>
                    </h3>
                    {paperMeta && <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{paperMeta}</p>}
                    <button type="button" data-paper-open={`details-${paper.slug}`} aria-haspopup="dialog" aria-controls={`details-${paper.slug}`} class={`${btnPrimary} mt-3 inline-flex items-center gap-1`}>{t.paperDetailsLabel} <span aria-hidden="true">&rarr;</span></button>
                    <PaperDialog entry={paper} />
                </div>
            </section>
        )}

        <nav class="mt-8 flex flex-wrap gap-3" aria-label="Project links">
            {data.url && <a class={btnPrimary} href={data.url} target="_blank" rel="noopener noreferrer">{t.liveLabel}</a>}
            {data.srccode && <a class={btn} href={data.srccode} target="_blank" rel="noopener noreferrer">{t.sourceLabel}</a>}
            {data.projectdesc && <a class={btn} href={data.projectdesc} target="_blank" rel="noopener noreferrer">{t.notesLabel}</a>}
        </nav>

        <div class="mt-8"><ReactionBar id={`project:${entry.slug}`} /></div>
        <SocialShare title={data.title} description={data.description} />
    </article>
</RootLayout>
