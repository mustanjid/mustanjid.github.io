---
import { SITE_METADATA } from "@/consts";
import RootLayout from "@/layouts/RootLayout.astro";
import AuthorLayoutHome from "@/pages/aboutHero.astro";
import CurrentResearch from "@/components/CurrentResearch.astro";
import HomeCards from "@/components/HomeCards.astro";
import TechNewsBox from "@/components/TechNewsBox.astro";
import RightNow from "@/components/RightNow.astro";
import HomeSpotlightThought from "@/components/HomeSpotlightThought.astro";
import HomeActivity from "@/components/HomeActivity.astro";
import { getProjects, getResearchKinds, isResearchProject } from "@/functions";

const projects = await getProjects();
const researchKinds = await getResearchKinds();
const currentResearch = projects.find((project) => isResearchProject(project, researchKinds));
const latestProject = projects.find((project) => !isResearchProject(project, researchKinds));
---

<RootLayout title={SITE_METADATA.title} description={SITE_METADATA.description} wide>
  <AuthorLayoutHome />
  <RightNow />
  <TechNewsBox />

  <section aria-label="Featured work and latest thoughts" class="mt-8">
    <div class="mb-4 flex flex-wrap items-end justify-between gap-3 border-b border-gray-200 pb-3 dark:border-gray-800">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary-700 dark:text-primary-300">A little of what I'm working on</p>
        <h2 class="mt-1 text-2xl font-bold text-gray-950 dark:text-gray-50">Explore my work</h2>
      </div>
    </div>
    <div class="grid items-stretch gap-4 lg:grid-cols-3">
      {currentResearch && <CurrentResearch size="tile" kind="research" project={currentResearch} />}
      {latestProject && <CurrentResearch size="tile" kind="other" project={latestProject} />}
      <HomeSpotlightThought />
    </div>
  </section>

  <div class="mt-12">
    <HomeCards view="publications" />
  </div>

  <HomeActivity />
</RootLayout>
