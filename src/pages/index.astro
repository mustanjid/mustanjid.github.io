---
import type { CollectionEntry } from "astro:content";
import { SITE_METADATA } from "@/consts";
import RootLayout from "@/layouts/RootLayout.astro";
import IntroCard from "@/components/home/IntroCard.astro";
import ClaudeCard from "@/components/home/ClaudeCard.astro";
import ToolStackCard from "@/components/home/ToolStackCard.astro";
import OngoingProjects from "@/components/home/OngoingProjects.astro";
import PublicationList from "@/components/home/PublicationList.astro";
import TechNewsBox from "@/components/TechNewsBox.astro";
import RightNow from "@/components/RightNow.astro";
import HomeSpotlightThought from "@/components/HomeSpotlightThought.astro";
import HomeActivity from "@/components/HomeActivity.astro";
import { getProjects, getResearchKinds, isResearchProject } from "@/functions";

const projects = await getProjects();
const researchKinds = await getResearchKinds();
const currentResearch = projects.find((project) => isResearchProject(project, researchKinds));
const latestProject = projects.find((project) => !isResearchProject(project, researchKinds));
// Projects marked "Show in Ongoing projects" in the CMS; falls back to current research + latest project.
const flagged = projects.filter((project) => project.data.ongoing);
const ongoing = (flagged.length > 0
  ? flagged
  : [currentResearch, latestProject].filter(Boolean)) as CollectionEntry<"projects">[];
---

<RootLayout title={SITE_METADATA.title} description={SITE_METADATA.description} wide>
  <div class="flex flex-col gap-4 pt-6 lg:flex-row lg:items-stretch">
    <div class="flex min-w-0 flex-1 flex-col gap-4">
      <div class="flex flex-1 flex-col [&>*]:flex-1"><IntroCard /></div>
      <div class="flex flex-col gap-4 md:flex-row [&>*]:flex-1"><RightNow /><ClaudeCard /></div>
    </div>
    <div class="flex min-w-0 flex-col gap-4 lg:w-[340px] lg:flex-none">
      <div class="flex flex-1 flex-col [&>*]:flex-1"><HomeSpotlightThought /></div>
      <ToolStackCard />
    </div>
  </div>

  <div class="mt-4"><TechNewsBox /></div>

  {ongoing.length > 0 && (
    <section aria-labelledby="ongoing-projects" class="mt-12">
      <div class="c2-section-head">
        <div>
          <p class="c2-eyebrow m-0">What I'm building</p>
          <h2 id="ongoing-projects" class="c2-title mt-1 text-2xl">Ongoing projects</h2>
        </div>
        <a href="/projects" class="cta-ghost">View all</a>
      </div>
      <OngoingProjects projects={ongoing} />
    </section>
  )}

  <section aria-labelledby="publications" class="mt-12">
    <div class="c2-section-head">
      <div>
        <p class="c2-eyebrow m-0">Research articles</p>
        <h2 id="publications" class="c2-title mt-1 text-2xl">Publications</h2>
      </div>
      <a href="/research" class="cta-ghost">View all</a>
    </div>
    <PublicationList />
  </section>

  <section aria-labelledby="activity-heading" class="mt-12">
    <div class="c2-section-head">
      <div>
        <p class="c2-eyebrow m-0">Recent</p>
        <h2 id="activity-heading" class="c2-title mt-1 text-2xl">Activity</h2>
      </div>
    </div>
    <HomeActivity />
  </section>
</RootLayout>
