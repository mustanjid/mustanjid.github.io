---
import { SITE_METADATA } from "@/consts";
import RootLayout from "@/layouts/RootLayout.astro";
import AuthorLayoutHome from "@/pages/aboutHero.astro";
import CurrentResearch from "@/components/CurrentResearch.astro";
import HomeCards from "@/components/HomeCards.astro";
import { getProjects } from "@/functions";

const projects = await getProjects();
const currentResearch = projects.find(({ data }) => data.kind === "research" && data.featured);
const currentDevelopment = projects.find(({ data }) => data.kind !== "research" && data.featured);
const hasBothProjects = Boolean(currentResearch && currentDevelopment);
const hasProject = Boolean(currentResearch || currentDevelopment);
const gridColumnsClass = hasBothProjects ? "xl:grid-cols-8" : hasProject ? "xl:grid-cols-7" : "xl:grid-cols-1";
const projectSpanClass = hasBothProjects ? "xl:col-span-3" : "xl:col-span-4";
const thoughtsSpanClass = hasBothProjects ? "xl:col-span-2" : hasProject ? "xl:col-span-3" : "xl:col-span-1";
---

<RootLayout title={SITE_METADATA.title} description={SITE_METADATA.description} wide>
  <AuthorLayoutHome />
  <section aria-label="Current research, development project, and latest thoughts" class:list={["mt-5 grid items-stretch gap-4", gridColumnsClass]}>
    {currentResearch && <div class:list={["min-w-0", projectSpanClass]}><CurrentResearch size="tile" kind="research" project={currentResearch} /></div>}
    {currentDevelopment && <div class:list={["min-w-0", projectSpanClass]}><CurrentResearch size="tile" kind="other" project={currentDevelopment} /></div>}
    <article aria-labelledby="latest-thoughts-title" class:list={["group relative flex h-full min-w-0 flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm transition hover:border-primary-300 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900/50 dark:hover:border-primary-700", thoughtsSpanClass]}>
      <div class="flex flex-1 flex-col p-4 sm:p-5">
        <HomeCards view="thoughts" />
      </div>
    </article>
  </section>
  <div class="mt-8">
    <HomeCards view="publications" />
  </div>
</RootLayout>
