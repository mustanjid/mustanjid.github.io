---
import { getCollection } from "astro:content";
import RootLayout from "@/layouts/RootLayout.astro";
import SocialShare from "@/layouts/share/SocialShare.astro";
import DetailReactions from "@/components/DetailReactions.astro";
import Comments from "@/components/Comments.astro";
import MomentGallery from "@/components/MomentGallery.astro";
import { getMoments } from "@/functions";
import { pagesData } from "@/data/content";
import { shareImageSource } from "@/og";

// One details page per moment: slider with every photo's description, the full general description, and sharing.
export async function getStaticPaths() {
  const categories = await getCollection("moment-categories");
  const names = new Map(categories.map(({ id, data }) => [id.replace(/\.mdx?$/, ""), data.name]));
  return getMoments().map((moment) => ({
    params: { slug: moment.slug },
    props: { moment: { ...moment, categoryLabel: names.get(moment.category) ?? moment.category } },
  }));
}

const t = pagesData.moments;
const { moment } = Astro.props;
const title = moment.caption || moment.categoryLabel;
const description = moment.description || moment.photos[0]?.description || moment.location || `${moment.categoryLabel} · ${t.title}`;
const cover = moment.photos[0];
---

<RootLayout
  title={`${title} | ${t.title}`}
  description={description}
  image={shareImageSource(cover.image, moment.sharePreview)}
  imageAlt={cover.description || title}
  wide
>
  <article class="mx-auto max-w-4xl py-8">
    <a href="/moments" class="text-sm font-semibold text-primary-600 hover:underline dark:text-primary-400">&larr; {t.backLabel}</a>

    <header class="mt-6">
      <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary-700 dark:text-primary-300">{moment.categoryLabel}</p>
      <h1 class="mt-2 text-2xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl">{title}</h1>
      {moment.location && (
        <p class="mt-2 flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400">
          <svg xmlns="http://www.w3.org/2000/svg" height="16" width="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
          <span>{moment.location}</span>
        </p>
      )}
    </header>

    <div class="mt-6">
      <MomentGallery photos={moment.photos} title={title} variant="detail" />
    </div>

    {moment.description && <p class="mt-6 max-w-2xl whitespace-pre-line text-base leading-7 text-gray-700 dark:text-gray-300">{moment.description}</p>}

    <div class="mt-8"><DetailReactions id={`moment:${moment.slug}`} /></div>
    <SocialShare title={title} description={description} />
    <Comments />
  </article>
</RootLayout>
