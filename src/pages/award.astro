---
import RootLayout from "@/layouts/RootLayout.astro";
import AchievementActions from "@/components/AchievementActions.astro";
import ShareHandler from "@/components/ShareHandler.astro";
import ReactionBar from "@/components/ReactionBar.astro";
import { reactionsAvailable } from "@/reactions";
import { pagesData } from "@/data/content";
import { certificateFacts, getAchievements } from "@/functions";

const { certificates, awards, featured } = getAchievements();
const reactionsOn = reactionsAvailable();

// Certificate details for the pop-up (kept out of the HTML cards so the grid stays compact).
const certificateData = certificates.map((certificate) => ({
  title: certificate.title,
  provider: certificate.provider,
  image: certificate.image,
  facts: certificateFacts(certificate),
  remarks: certificate.remarks ?? "",
  shareEnabled: certificate.shareEnabled,
  path: `/award/${certificate.slug}/`,
  shareUrl: new URL(`/award/${certificate.slug}/`, Astro.site).href,
}));
const certificateJson = JSON.stringify(certificateData).replace(/</g, "\\u003c");
---

<RootLayout title={pagesData.achievements.seoTitle} description={pagesData.achievements.seoDescription}>
  <div class="space-y-7 py-4">
    <header class="space-y-2">
      <h1 class="text-2xl font-extrabold leading-8 tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl">{pagesData.achievements.title}</h1>
      <p class="text-base leading-6 text-gray-600 dark:text-gray-400">{pagesData.achievements.subtitle}</p>
    </header>

    <nav class="flex flex-wrap gap-2" aria-label="Filter achievements">
      <button type="button" data-achievement-filter="all" aria-pressed="true" class="rounded-full bg-primary-700 px-4 py-2 text-sm font-semibold text-white">{pagesData.achievements.filterAll}</button>
      <button type="button" data-achievement-filter="awards" aria-pressed="false" class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800">{pagesData.achievements.filterAwards}</button>
      <button type="button" data-achievement-filter="certificates" aria-pressed="false" class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800">{pagesData.achievements.filterCertificates}</button>
    </nav>

    <section data-achievement-section="awards" class="space-y-8">
      {featured.enabled && featured.title && (
      <article class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900/50">
        <div class="grid md:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
          <figure class="min-h-56 bg-gray-100 dark:bg-gray-800">
            {featured.image && <img src={featured.image} alt={featured.imageAlt ?? ""} class="h-full min-h-56 w-full object-cover" loading="lazy" />}
            {featured.imageAlt && <figcaption class="sr-only">{featured.imageAlt}</figcaption>}
          </figure>
          <div class="flex flex-col justify-center p-5 sm:p-7">
            <p class="text-sm font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">{featured.eyebrow}</p>
            <h2 class="mt-2 text-xl font-bold leading-7 text-gray-900 dark:text-gray-100 sm:text-2xl">{featured.title}</h2>
            <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">{featured.description}</p>
            <dl class="mt-5 grid gap-2 text-sm sm:grid-cols-[5rem_minmax(0,1fr)]">
              {featured.organizers && (<><dt class="font-semibold text-gray-500 dark:text-gray-400">Organizers</dt><dd class="text-gray-700 dark:text-gray-200">{featured.organizers}</dd></>)}
              {featured.team && (<><dt class="font-semibold text-gray-500 dark:text-gray-400">Team</dt><dd class="text-gray-700 dark:text-gray-200">{featured.team}</dd></>)}
              {featured.location && (<><dt class="font-semibold text-gray-500 dark:text-gray-400">Location</dt><dd class="text-gray-700 dark:text-gray-200">{featured.location}</dd></>)}
            </dl>
            {(featured.shareEnabled || reactionsOn) && (
              <div class="mt-5 flex flex-wrap items-center gap-3">
                <ReactionBar id={`award:${featured.slug}`} />
                {featured.shareEnabled && <AchievementActions slug={featured.slug} />}
              </div>
            )}
          </div>
        </div>
      </article>
      )}

      <section aria-labelledby="awards-heading" class="space-y-4">
        <h2 id="awards-heading" class="text-xl font-bold text-gray-900 dark:text-gray-100">{pagesData.achievements.awardsHeading}</h2>
        <ol class="relative space-y-5 border-s-2 border-gray-200 ps-5 dark:border-gray-700">
          {awards.map((award) => (
            <li class="relative">
              <span class="absolute -start-[1.65rem] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-primary-600 dark:border-gray-950" aria-hidden="true"></span>
              <p class="text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">{award.date}</p>
              <h3 class="mt-1 text-base font-semibold text-gray-900 dark:text-gray-100">{award.title}</h3>
              {award.issuer && <p class="mt-1 text-sm font-medium text-gray-700 dark:text-gray-300">{award.issuer}</p>}
              {award.description && <p class="mt-1 text-sm leading-5 text-gray-600 dark:text-gray-400">{award.description}</p>}
              {(award.shareEnabled || reactionsOn) && (
                <div class="mt-3 flex flex-wrap items-center gap-3">
                  <ReactionBar id={`award:${award.slug}`} compact />
                  {award.shareEnabled && <AchievementActions slug={award.slug} />}
                </div>
              )}
            </li>
          ))}
        </ol>
      </section>
    </section>

    <section data-achievement-section="certificates" aria-labelledby="certificates-heading" class="space-y-4">
      <div>
        <h2 id="certificates-heading" class="text-xl font-bold text-gray-900 dark:text-gray-100">{pagesData.achievements.certificatesHeading}</h2>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{pagesData.achievements.certificatesHint}</p>
      </div>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {certificates.map((certificate, index) => (
          <li class="flex flex-col overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:border-primary-400 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/50">
            <button
              type="button"
              data-certificate-open
              data-certificate-index={index}
              class="group w-full flex-1 text-left"
              aria-label={`View ${certificate.title} certificate from ${certificate.provider}`}
            >
              <img src={certificate.image} alt="" class="aspect-[4/3] w-full bg-gray-50 object-contain p-2 dark:bg-gray-800" loading="lazy" />
              <span class="block p-3">
                <span class="block line-clamp-2 text-sm font-semibold text-gray-900 group-hover:text-primary-700 dark:text-gray-100 dark:group-hover:text-primary-300">{certificate.title}</span>
                <span class="mt-1 block text-sm font-medium text-gray-600 dark:text-gray-300">{certificate.provider}</span>
              </span>
            </button>
            {(certificate.shareEnabled || reactionsOn) && (
              <div class="flex flex-wrap items-center gap-2.5 border-t border-gray-200 p-2.5 dark:border-gray-800">
                <ReactionBar id={`award:${certificate.slug}`} compact />
                {certificate.shareEnabled && <AchievementActions slug={certificate.slug} />}
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  </div>

  <dialog id="certificate-dialog" aria-labelledby="certificate-dialog-title" class="fixed inset-0 m-0 h-full max-h-none w-full max-w-none overflow-y-auto bg-transparent p-0 text-white backdrop:bg-black/60 backdrop:backdrop-blur-xl">
    <!-- Open view: the certificate and its details sit on the blurred page, no card. -->
    <div class="mx-auto flex min-h-full max-w-4xl flex-col items-center gap-4 px-4 py-6 sm:py-10">
      <div class="flex w-full items-start justify-between gap-4 [text-shadow:0_1px_8px_rgb(0_0_0/0.6)]">
        <h2 id="certificate-dialog-title" class="text-base font-semibold text-white"></h2>
        <button type="button" data-certificate-close class="shrink-0 rounded-full bg-white/15 px-4 py-2 text-sm font-semibold text-white backdrop-blur hover:bg-white/25 focus:outline-none focus:ring-2 focus:ring-white">{pagesData.achievements.closeLabel}</button>
      </div>
      <img data-certificate-dialog-image src="" alt="" class="max-h-[62vh] max-w-full rounded-lg bg-white object-contain shadow-2xl" />
      <div data-certificate-info class="w-full space-y-3 [text-shadow:0_1px_8px_rgb(0_0_0/0.6)]" hidden>
        <dl data-certificate-facts class="grid gap-x-4 gap-y-1.5 text-sm sm:grid-cols-[8rem_minmax(0,1fr)]"></dl>
        <p data-certificate-remarks class="whitespace-pre-line text-sm leading-6 text-white/90"></p>
        <div data-certificate-actions data-share-root hidden class="flex flex-wrap items-center gap-2.5">
          <a data-certificate-details href="#" class="inline-flex min-h-9 items-center gap-1 rounded-full bg-white px-4 py-1.5 text-xs font-semibold text-gray-900 hover:bg-gray-200">
            {pagesData.achievements.detailsLabel} <span aria-hidden="true">&rarr;</span>
          </a>
          <button type="button" data-certificate-share data-share-action="native" data-share-url="" class="inline-flex min-h-9 items-center gap-1.5 rounded-full border border-white/60 px-4 py-1.5 text-xs font-semibold text-white hover:bg-white/15 focus:outline-none focus:ring-2 focus:ring-white">
            <svg xmlns="http://www.w3.org/2000/svg" height="14" width="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" /><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" /></svg>
            <span data-share-label>{pagesData.achievements.shareLabel}</span>
          </button>
          <span data-share-status role="status" aria-live="polite" class="sr-only"></span>
        </div>
      </div>
    </div>
  </dialog>
  <script is:inline type="application/json" id="certificate-data" set:html={certificateJson} />
  <ShareHandler />
</RootLayout>

<script>
  // Delegated listeners: Astro View Transitions swap the page body without re-running this script, so listeners
  // attached straight to the buttons stop working after the first client-side navigation.
  type Fact = { label: string; value: string; href?: string };
  type Certificate = { title: string; provider: string; image: string; facts: Fact[]; remarks: string; shareEnabled: boolean; path: string; shareUrl: string };

  const w = window as unknown as { __achievementsReady?: boolean };
  const activeClass = "rounded-full bg-primary-700 px-4 py-2 text-sm font-semibold text-white";
  const inactiveClass = "rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800";
  const termClass = "font-semibold text-white/60";
  const valueClass = "text-white/90";

  const readCertificates = (): Certificate[] => {
    try {
      return JSON.parse(document.getElementById("certificate-data")?.textContent ?? "[]");
    } catch {
      return [];
    }
  };

  const openCertificate = (certificate: Certificate) => {
    const dialog = document.querySelector<HTMLDialogElement>("#certificate-dialog");
    if (!dialog) return;
    const title = dialog.querySelector<HTMLElement>("#certificate-dialog-title");
    const image = dialog.querySelector<HTMLImageElement>("[data-certificate-dialog-image]");
    const info = dialog.querySelector<HTMLElement>("[data-certificate-info]");
    const facts = dialog.querySelector<HTMLElement>("[data-certificate-facts]");
    const remarks = dialog.querySelector<HTMLElement>("[data-certificate-remarks]");
    const actions = dialog.querySelector<HTMLElement>("[data-certificate-actions]");
    const details = dialog.querySelector<HTMLAnchorElement>("[data-certificate-details]");
    const share = dialog.querySelector<HTMLElement>("[data-certificate-share]");
    if (!title || !image || !info || !facts || !remarks || !actions || !details || !share) return;

    title.textContent = `${certificate.title} — ${certificate.provider}`;
    image.src = certificate.image;
    image.alt = `${certificate.title} — ${certificate.provider}`;

    facts.replaceChildren();
    certificate.facts.forEach((fact) => {
      const term = document.createElement("dt");
      term.className = termClass;
      term.textContent = fact.label;
      const value = document.createElement("dd");
      value.className = valueClass;
      if (fact.href) {
        const link = document.createElement("a");
        link.href = fact.href;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.className = "font-semibold text-primary-200 hover:underline";
        link.textContent = fact.value;
        value.append(link);
      } else {
        value.textContent = fact.value;
      }
      facts.append(term, value);
    });
    remarks.textContent = certificate.remarks;
    remarks.hidden = certificate.remarks === "";
    actions.hidden = !certificate.shareEnabled;
    details.href = certificate.path;
    share.dataset.shareUrl = certificate.shareUrl;
    info.hidden = certificate.facts.length === 0 && !certificate.remarks && !certificate.shareEnabled;
    dialog.showModal();
  };

  if (!w.__achievementsReady) {
    w.__achievementsReady = true;

    document.addEventListener("click", (event) => {
      const target = event.target as Element;

      const filterButton = target.closest<HTMLButtonElement>("[data-achievement-filter]");
      if (filterButton) {
        const filter = filterButton.dataset.achievementFilter;
        document.querySelectorAll<HTMLButtonElement>("[data-achievement-filter]").forEach((item) => {
          const selected = item === filterButton;
          item.setAttribute("aria-pressed", String(selected));
          item.className = selected ? activeClass : inactiveClass;
        });
        document.querySelectorAll<HTMLElement>("[data-achievement-section]").forEach((section) => {
          section.classList.toggle("hidden", filter !== "all" && section.dataset.achievementSection !== filter);
        });
        return;
      }

      const openButton = target.closest<HTMLButtonElement>("[data-certificate-open]");
      if (openButton) {
        const certificate = readCertificates()[Number(openButton.dataset.certificateIndex)];
        if (certificate) openCertificate(certificate);
        return;
      }

      const dialog = document.querySelector<HTMLDialogElement>("#certificate-dialog");
      if (dialog && (target.closest("[data-certificate-close]") || target === dialog)) dialog.close();
    });
  }
</script>
