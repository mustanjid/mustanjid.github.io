---
import RootLayout from "@/layouts/RootLayout.astro";

const certificates = [
  { title: "Object Oriented Analysis & Design", provider: "DevSkill", image: "/static/images/certificates/devskill.png" },
  { title: "JavaScript Algorithms & Data Structures", provider: "freeCodeCamp", image: "/static/images/certificates/FCJs.png" },
  { title: "Responsive Web Design", provider: "freeCodeCamp", image: "/static/images/certificates/Responsive.png" },
  { title: "Certificate of Reviewing", provider: "Elsevier", image: "/static/images/certificates/Reviewer2.png" },
  { title: "Certificate of Reviewing", provider: "Elsevier", image: "/static/images/certificates/Reviewer.png" },
  { title: "An Introduction to Peer Review", provider: "Clarivate", image: "/static/images/certificates/PublonPeerReview.png" },
  { title: "Reviewing in the Sciences", provider: "Clarivate", image: "/static/images/certificates/PublonScience.png" },
  { title: "Python for Data Science", provider: "Kaggle", image: "/static/images/certificates/Kgaale.png" },
];

const awards = [
  {
    date: "2020–2022",
    title: "Research Publication Award",
    description: "Recognized for scholarly publications by the Division of Research, Daffodil International University.",
  },
  {
    date: "2015–2018",
    title: "Undergraduate Merit Scholarship",
    description: "Received a merit scholarship throughout the undergraduate program.",
  },
  {
    date: "2009",
    title: "Government Junior Scholarship",
    description: "Awarded by the Ministry of Education, Bangladesh.",
  },
  {
    date: "2006",
    title: "Government Primary Scholarship",
    description: "Awarded by the Ministry of Education, Bangladesh.",
  },
];
---

<RootLayout title="Achievements & Certificates" description="Selected achievements, awards, scholarships, and professional certificates.">
  <div class="space-y-7 py-4">
    <header class="space-y-2">
      <h1 class="text-2xl font-extrabold leading-8 tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl">Achievements &amp; Certificates</h1>
      <p class="text-base leading-6 text-gray-600 dark:text-gray-400">A selection of milestones, recognitions, and professional learning.</p>
    </header>

    <nav class="flex flex-wrap gap-2" aria-label="Filter achievements">
      <button type="button" data-achievement-filter="all" aria-pressed="true" class="rounded-full bg-primary-700 px-4 py-2 text-sm font-semibold text-white">All</button>
      <button type="button" data-achievement-filter="awards" aria-pressed="false" class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800">Awards</button>
      <button type="button" data-achievement-filter="certificates" aria-pressed="false" class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800">Certificates</button>
    </nav>

    <section data-achievement-section="awards" class="space-y-8">
      <article class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm dark:border-gray-800 dark:bg-gray-900/50">
        <div class="grid md:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)]">
          <figure class="min-h-56 bg-gray-100 dark:bg-gray-800">
            <img src="/static/images/hakathon23.jpeg" alt="Justice Journey team receiving the hackathon award" class="h-full min-h-56 w-full object-cover" loading="lazy" />
            <figcaption class="sr-only">Justice Journey team receiving the hackathon award.</figcaption>
          </figure>
          <div class="flex flex-col justify-center p-5 sm:p-7">
            <p class="text-sm font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">Featured achievement · October 2023</p>
            <h2 class="mt-2 text-xl font-bold leading-7 text-gray-900 dark:text-gray-100 sm:text-2xl">1st Runner Up — Workers’ Access to Justice Hackathon</h2>
            <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">Worked with Team Justice Journey in Bangladesh’s first hackathon focused on workers’ access to justice. We proposed a digital solution to improve access to justice for domestic workers.</p>
            <dl class="mt-5 grid gap-2 text-sm sm:grid-cols-[5rem_minmax(0,1fr)]">
              <dt class="font-semibold text-gray-500 dark:text-gray-400">Organizers</dt>
              <dd class="text-gray-700 dark:text-gray-200">Rule of Law Collaborative, University of South Carolina, and BLAST</dd>
              <dt class="font-semibold text-gray-500 dark:text-gray-400">Team</dt>
              <dd class="text-gray-700 dark:text-gray-200">Justice Journey</dd>
              <dt class="font-semibold text-gray-500 dark:text-gray-400">Location</dt>
              <dd class="text-gray-700 dark:text-gray-200">Dhaka, Bangladesh</dd>
            </dl>
          </div>
        </div>
      </article>

      <section aria-labelledby="awards-heading" class="space-y-4">
        <h2 id="awards-heading" class="text-xl font-bold text-gray-900 dark:text-gray-100">Awards &amp; scholarships</h2>
        <ol class="relative space-y-5 border-s-2 border-gray-200 ps-5 dark:border-gray-700">
          {awards.map((award) => (
            <li class="relative">
              <span class="absolute -start-[1.65rem] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-primary-600 dark:border-gray-950" aria-hidden="true"></span>
              <p class="text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300">{award.date}</p>
              <h3 class="mt-1 text-base font-semibold text-gray-900 dark:text-gray-100">{award.title}</h3>
              <p class="mt-1 text-sm leading-5 text-gray-600 dark:text-gray-400">{award.description}</p>
            </li>
          ))}
        </ol>
      </section>
    </section>

    <section data-achievement-section="certificates" aria-labelledby="certificates-heading" class="space-y-4">
      <div>
        <h2 id="certificates-heading" class="text-xl font-bold text-gray-900 dark:text-gray-100">Certificates</h2>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Select a certificate to view it at a larger size.</p>
      </div>
      <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
        {certificates.map((certificate, index) => (
          <li>
            <button
              type="button"
              data-certificate-open
              data-certificate-title={`${certificate.title} — ${certificate.provider}`}
              data-certificate-image={certificate.image}
              class="group w-full overflow-hidden rounded-xl border border-gray-200 bg-white text-left transition hover:border-primary-400 hover:shadow-md dark:border-gray-800 dark:bg-gray-900/50"
              aria-label={`View ${certificate.title} certificate from ${certificate.provider}`}
            >
              <img src={certificate.image} alt="" class="aspect-[4/3] w-full bg-gray-50 object-contain p-2 dark:bg-gray-800" loading="lazy" />
              <span class="block p-3">
                <span class="block line-clamp-2 text-sm font-semibold text-gray-900 group-hover:text-primary-700 dark:text-gray-100 dark:group-hover:text-primary-300">{certificate.title}</span>
                <span class="mt-1 block text-sm font-medium text-gray-600 dark:text-gray-300">{certificate.provider}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <dialog id="certificate-dialog" aria-labelledby="certificate-dialog-title" class="m-auto max-h-[90vh] w-[calc(100%-2rem)] max-w-4xl overflow-hidden rounded-xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-black/70 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100">
    <div class="flex items-center justify-between gap-4 border-b border-gray-200 p-3 dark:border-gray-700">
      <h2 id="certificate-dialog-title" class="text-sm font-semibold"></h2>
      <button type="button" data-certificate-close class="rounded-md border border-gray-300 px-3 py-1.5 text-sm font-semibold hover:bg-gray-100 dark:border-gray-600 dark:hover:bg-gray-800">Close</button>
    </div>
    <img data-certificate-dialog-image src="" alt="" class="max-h-[78vh] w-full object-contain p-3" />
  </dialog>
</RootLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-achievement-filter]");
  const sections = document.querySelectorAll<HTMLElement>("[data-achievement-section]");
  const activeClass = "rounded-full bg-primary-700 px-4 py-2 text-sm font-semibold text-white";
  const inactiveClass = "rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800";

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.achievementFilter;
      filterButtons.forEach((item) => {
        const selected = item === button;
        item.setAttribute("aria-pressed", String(selected));
        item.className = selected ? activeClass : inactiveClass;
      });
      sections.forEach((section) => {
        section.classList.toggle("hidden", filter !== "all" && section.dataset.achievementSection !== filter);
      });
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>("#certificate-dialog");
  const dialogTitle = document.querySelector<HTMLElement>("#certificate-dialog-title");
  const dialogImage = document.querySelector<HTMLImageElement>("[data-certificate-dialog-image]");

  document.querySelectorAll<HTMLButtonElement>("[data-certificate-open]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!dialog || !dialogTitle || !dialogImage) return;
      dialogTitle.textContent = button.dataset.certificateTitle ?? "Certificate";
      dialogImage.src = button.dataset.certificateImage ?? "";
      dialogImage.alt = button.dataset.certificateTitle ?? "Certificate";
      dialog.showModal();
    });
  });

  dialog?.querySelector<HTMLButtonElement>("[data-certificate-close]")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
