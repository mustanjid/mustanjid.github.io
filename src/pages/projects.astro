---
import Card from "@/components/Card.astro";
import ResearchProjectCard from "@/components/ResearchProjectCard.astro";
import RootLayout from "@/layouts/RootLayout.astro";
import { getProjects, isResearchProject, toCardProps } from "@/functions";
import { pagesData } from "@/data/content";

const t = pagesData.projects;
const allProjects = await getProjects();
const researchProjects = allProjects.filter(isResearchProject);
const developmentProjects = allProjects.filter((project) => !isResearchProject(project));
const latestResearch = researchProjects[0];
const latestDevelopment = developmentProjects[0];
---

<RootLayout title={t.seoTitle} description={t.seoDescription}>
    <div class="divide-y divide-gray-200 dark:divide-gray-700">
        <div class="space-y-1 pb-1 pt-1 md:space-y-1">
            <h1 class="text-2xl font-extrabold leading-8 tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl sm:leading-9 md:text-3xl">
                {t.title}
            </h1>
            <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">
                {t.subtitle}
            </p>
        </div>

        <div class="space-y-6 py-8">
            <nav class="flex flex-wrap gap-2" aria-label="Filter projects">
                <button type="button" data-project-filter="latest" aria-pressed="true" class="rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white">{t.tabLatest}</button>
                <button type="button" data-project-filter="research" aria-pressed="false" class="rounded-md px-4 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800">{t.tabResearch}</button>
                <button type="button" data-project-filter="development" aria-pressed="false" class="rounded-md px-4 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800">{t.tabDevelopment}</button>
            </nav>

            <section data-project-panel="latest" aria-label="Latest projects" class="grid grid-cols-1 gap-5 md:grid-cols-2">
                {latestResearch ? (
                    <ResearchProjectCard project={latestResearch} variant="latest" />
                ) : (
                    <article class="rounded-xl border border-gray-200 p-6 text-gray-500 dark:border-gray-800 dark:text-gray-400">{t.comingSoonResearch}</article>
                )}

                {latestDevelopment ? (
                    <Card {...toCardProps(latestDevelopment)} />
                ) : (
                    <article class="rounded-xl border border-gray-200 p-6 text-gray-500 dark:border-gray-800 dark:text-gray-400">{t.comingSoonDevelopment}</article>
                )}
            </section>

            <section data-project-panel="research" aria-label="All research projects" class="hidden">
                {researchProjects.length > 0 ? (
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        {researchProjects.map((project) => <ResearchProjectCard project={project} />)}
                    </div>
                ) : (
                    <p class="text-gray-500 dark:text-gray-400">{t.emptyResearch}</p>
                )}
            </section>

            <section data-project-panel="development" aria-label="All development projects" class="hidden">
                {developmentProjects.length > 0 ? (
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        {developmentProjects.map((project) => <Card {...toCardProps(project)} />)}
                    </div>
                ) : (
                    <p class="text-gray-500 dark:text-gray-400">{t.emptyDevelopment}</p>
                )}
            </section>
        </div>
    </div>
</RootLayout>

<script>
    const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-project-filter]");
    const projectPanels = document.querySelectorAll<HTMLElement>("[data-project-panel]");
    const selectedButtonClass = "rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white";
    const unselectedButtonClass = "rounded-md px-4 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800";

    filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
            const selectedFilter = button.dataset.projectFilter;

            filterButtons.forEach((item) => {
                const isSelected = item === button;
                item.setAttribute("aria-pressed", String(isSelected));
                item.className = isSelected ? selectedButtonClass : unselectedButtonClass;
            });

            projectPanels.forEach((panel) => {
                panel.classList.toggle("hidden", panel.dataset.projectPanel !== selectedFilter);
            });
        });
    });
</script>
