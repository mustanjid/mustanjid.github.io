---
import ProjectCard from "@/components/ProjectCard.astro";
import RootLayout from "@/layouts/RootLayout.astro";
import { getProjectGroups } from "@/functions";
import { pagesData } from "@/data/content";

const t = pagesData.projects;
// One tab per project category (created in the CMS), plus "Latest" = the newest project of every category.
const groups = await getProjectGroups();
const selectedTab = "rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white";
const idleTab = "rounded-md px-4 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800";
---

<RootLayout title={t.seoTitle} description={t.seoDescription}>
    <div class="divide-y divide-gray-200 dark:divide-gray-700">
        <div class="space-y-1 pb-1 pt-1 md:space-y-1">
            <h1 class="text-2xl font-extrabold leading-8 tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl sm:leading-9 md:text-3xl">
                {t.title}
            </h1>
            <p class="text-lg leading-7 text-gray-500 dark:text-gray-400">
                {t.subtitle}
            </p>
        </div>

        {groups.length > 0 ? (
            <div class="space-y-6 py-8" data-project-tabs>
                <nav class="flex flex-wrap gap-2" aria-label="Filter projects">
                    <button type="button" data-project-filter="latest" aria-pressed="true" class={selectedTab}>{t.tabLatest}</button>
                    {groups.map(({ category }) => (
                        <button type="button" data-project-filter={category.slug} aria-pressed="false" class={idleTab}>{category.name}</button>
                    ))}
                </nav>

                <section data-project-panel="latest" aria-label="Latest projects" class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    {groups.map(({ category, projects }) => <ProjectCard project={projects[0]} categoryName={category.name} variant="latest" />)}
                </section>

                {groups.map(({ category, projects }) => (
                    <section data-project-panel={category.slug} aria-label={category.name} class="hidden">
                        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                            {projects.map((project) => <ProjectCard project={project} categoryName={category.name} />)}
                        </div>
                    </section>
                ))}
            </div>
        ) : (
            <p class="py-8 text-gray-500 dark:text-gray-400">{t.emptyProjects}</p>
        )}
    </div>
</RootLayout>

<script>
    // Delegated listener: Astro View Transitions swap the page body without re-running this module script,
    // so listeners attached directly to the buttons die after "Project details -> All projects".
    const w = window as unknown as { __projectTabsReady?: boolean };
    const selectedButtonClass = "rounded-md bg-primary-600 px-4 py-2 text-sm font-semibold text-white";
    const unselectedButtonClass = "rounded-md px-4 py-2 text-sm font-semibold text-gray-600 hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-gray-800";

    if (!w.__projectTabsReady) {
        w.__projectTabsReady = true;

        document.addEventListener("click", (event) => {
            const button = (event.target as Element).closest<HTMLButtonElement>("[data-project-filter]");
            const root = button?.closest<HTMLElement>("[data-project-tabs]");
            if (!button || !root) return;

            const selectedFilter = button.dataset.projectFilter;
            root.querySelectorAll<HTMLButtonElement>("[data-project-filter]").forEach((item) => {
                const isSelected = item === button;
                item.setAttribute("aria-pressed", String(isSelected));
                item.className = isSelected ? selectedButtonClass : unselectedButtonClass;
            });
            root.querySelectorAll<HTMLElement>("[data-project-panel]").forEach((panel) => {
                panel.classList.toggle("hidden", panel.dataset.projectPanel !== selectedFilter);
            });
        });
    }
</script>
