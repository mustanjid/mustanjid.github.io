---
import { getCollection } from "astro:content";
import { pagesData, momentsData } from "@/data/content";
import { getMoments } from "@/functions";
import MomentGallery from "@/components/MomentGallery.astro";
import ReactionBar from "@/components/ReactionBar.astro";
import MomentMotif from "@/components/MomentMotif.astro";
import ShareHandler from "@/components/ShareHandler.astro";
import RootLayout from "@/layouts/RootLayout.astro";

const t = pagesData.moments;
const categories = (await getCollection("moment-categories"))
  .map(({ id, data }) => ({ id: id.replace(/\.mdx?$/, ""), data }))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const categoryNames = new Map(categories.map(({ id, data }) => [id, data.name]));
const galleryItems = getMoments().map((item) => {
  const categoryLabel = categoryNames.get(item.category);
  if (!categoryLabel) {
    throw new Error(`Unknown Moments category "${item.category}" for "${item.caption ?? item.slug}".`);
  }
  const path = `/moments/${item.slug}/`; // trailing slash matches the page canonical/og:url
  const title = item.caption || categoryLabel;
  return {
    ...item,
    title,
    categoryLabel,
    path,
    shareUrl: new URL(path, Astro.site).href,
  };
});
const usedCategories = categories.filter(({ id }) => momentsData.items.some((item) => item.category === id));
---

<RootLayout title={t.seoTitle} description={t.seoDescription} wide>
  <header class="mb-6 border-b border-gray-200 pb-4 dark:border-gray-800">
    <h1 class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100">{t.title}</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600 dark:text-gray-300">
      {momentsData.intro}
    </p>
  </header>

  <nav class="mt-8 flex flex-wrap gap-2" aria-label="Filter moments by category">
    <button
      type="button"
      data-moments-filter="all"
      aria-pressed="true"
      class="rounded-full bg-primary-700 px-4 py-2 text-sm font-semibold text-white"
    >
      All
    </button>
    {usedCategories.map(({ id, data }) => (
      <button
        type="button"
        data-moments-filter={id}
        aria-pressed="false"
        class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800"
      >
        {data.name}
      </button>
    ))}
  </nav>

  {galleryItems.length > 0 ? (
    <ul class="mt-4 grid grid-cols-1 gap-x-8 lg:grid-cols-2">
      {galleryItems.map((item) => (
        <li
          data-moment-card
          data-moment-category={item.category}
          data-moment-caption={item.title}
          data-moment-category-label={item.categoryLabel}
          data-moment-path={item.path}
          class="py-4"
        >
          <article class="space-y-3">
            <div class="max-w-[36rem]">
              <MomentGallery photos={item.photos} title={item.title} />
            </div>
            <div class="relative isolate min-h-32 max-w-[36rem] py-2">
              <MomentMotif category={item.category} />
              <div class="relative z-10">
                {item.caption && <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary-700 dark:text-primary-300">{item.categoryLabel}</p>}
                <h2 class="mt-2 text-xl font-bold leading-tight text-gray-900 dark:text-gray-100 sm:text-2xl">
                  <a href={item.path} class="hover:text-primary-700 dark:hover:text-primary-300">{item.title}</a>
                </h2>
                {item.location && (
                  <p class="mt-1.5 flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" height="14" width="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></svg>
                    <span>{item.location}</span>
                  </p>
                )}
                {item.description && <p class="mt-3 line-clamp-2 max-w-xl whitespace-pre-line text-sm leading-6 text-gray-600 dark:text-gray-300">{item.description}</p>}
                <div data-share-root class="mt-4 flex flex-wrap items-center gap-3">
                  <a
                    href={item.path}
                    class="inline-flex items-center gap-1 rounded-md bg-primary-700 px-3 py-1.5 text-sm font-semibold text-white hover:bg-primary-800 dark:bg-primary-500 dark:text-gray-950 dark:hover:bg-primary-400"
                  >
                    {t.detailsLabel} <span aria-hidden="true">&rarr;</span>
                  </a>
                  <button
                    type="button"
                    data-share-action="native"
                    data-share-url={item.shareUrl}
                    class="inline-flex items-center gap-1.5 rounded-full border border-gray-300 px-3 py-1.5 text-xs font-semibold text-gray-700 transition hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800"
                  >
                    <svg xmlns="http://www.w3.org/2000/svg" height="14" width="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="18" cy="5" r="3" /><circle cx="6" cy="12" r="3" /><circle cx="18" cy="19" r="3" />
                      <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4" />
                    </svg>
                    <span data-share-label>{t.shareLabel}</span>
                  </button>
                  <ReactionBar id={`moment:${item.slug}`} compact />
                  <span data-share-status role="status" aria-live="polite" class="sr-only"></span>
                </div>
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-8 py-8 text-center text-sm text-gray-600 dark:text-gray-300">
      No moments have been added yet.
    </p>
  )}

  <dialog
    id="moment-lightbox"
    aria-labelledby="moment-lightbox-caption"
    class="m-auto max-h-[94vh] w-[calc(100%-2rem)] max-w-6xl overflow-hidden rounded-2xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-black/80 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
  >
    <div class="flex items-center justify-between gap-4 border-b border-gray-200 p-3 dark:border-gray-700">
      <div class="min-w-0">
        <p data-lightbox-category class="text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300"></p>
        <h2 id="moment-lightbox-caption" data-lightbox-caption class="mt-1 truncate text-sm font-semibold"></h2>
      </div>
      <div class="flex shrink-0 items-center gap-3">
        <span data-lightbox-counter class="text-sm font-medium text-gray-500 dark:text-gray-400"></span>
        <button
          type="button"
          data-lightbox-close
          class="rounded-md border border-gray-300 px-3 py-1.5 text-sm font-semibold hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-gray-600 dark:hover:bg-gray-800"
        >
          Close
        </button>
      </div>
    </div>
    <div class="relative bg-black">
      <img data-lightbox-image src="" alt="" class="max-h-[66vh] w-full object-contain" />
      <button
        type="button"
        data-lightbox-prev
        aria-label="Previous photo"
        class="absolute left-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/55 text-2xl text-white hover:bg-black/75 focus:outline-none focus:ring-2 focus:ring-white sm:left-4"
      >
        <span aria-hidden="true">&#8249;</span>
      </button>
      <button
        type="button"
        data-lightbox-next
        aria-label="Next photo"
        class="absolute right-2 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-black/55 text-2xl text-white hover:bg-black/75 focus:outline-none focus:ring-2 focus:ring-white sm:right-4"
      >
        <span aria-hidden="true">&#8250;</span>
      </button>
    </div>
    <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-2 border-t border-gray-200 p-3 dark:border-gray-700">
      <p data-lightbox-description class="max-h-24 min-w-0 flex-1 overflow-y-auto whitespace-pre-line text-sm leading-6 text-gray-700 dark:text-gray-200"></p>
      <a data-lightbox-details href="#" class="shrink-0 text-sm font-semibold text-primary-600 hover:underline dark:text-primary-400">
        {t.detailsLabel} <span aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </dialog>
  <ShareHandler />
</RootLayout>

<script>
  // Delegated listeners: Astro View Transitions swap the page body without re-running module scripts, so
  // per-button listeners die after the first client-side navigation (e.g. Home -> Moments -> Home -> Moments).
  // (The photo sliders' dots and scroll sync live in MomentGallery.astro.)
  const w = window as unknown as { __momentsReady?: boolean };
  const activeClass = "rounded-full bg-primary-700 px-4 py-2 text-sm font-semibold text-white";
  const inactiveClass = "rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800";

  type Photo = { src: string; alt: string; description: string };
  const lightbox = { photos: [] as Photo[], index: 0, track: null as HTMLElement | null };

  const getDialog = () => document.querySelector<HTMLDialogElement>("#moment-lightbox");

  const showPhoto = (index: number) => {
    const dialog = getDialog();
    if (!dialog || lightbox.photos.length === 0) return;
    const total = lightbox.photos.length;
    lightbox.index = (index + total) % total; // arrows wrap around
    const photo = lightbox.photos[lightbox.index];
    const image = dialog.querySelector<HTMLImageElement>("[data-lightbox-image]");
    const counter = dialog.querySelector<HTMLElement>("[data-lightbox-counter]");
    const description = dialog.querySelector<HTMLElement>("[data-lightbox-description]");
    if (image) {
      image.src = photo.src;
      image.alt = photo.alt;
    }
    if (counter) counter.textContent = total > 1 ? `${lightbox.index + 1} / ${total}` : "";
    if (description) {
      description.textContent = photo.description;
      description.hidden = photo.description === "";
    }
    dialog.querySelectorAll<HTMLElement>("[data-lightbox-prev], [data-lightbox-next]").forEach((button) => (button.hidden = total < 2));
    // warm the cache for the neighbours so arrow clicks feel instant
    [lightbox.index - 1, lightbox.index + 1].forEach((i) => {
      const neighbour = lightbox.photos[(i + total) % total];
      if (neighbour) new Image().src = neighbour.src;
    });
  };

  const closeLightbox = (dialog: HTMLDialogElement) => {
    // leave the card on the photo the visitor was looking at
    const track = lightbox.track;
    if (track) {
      const left = lightbox.index * track.clientWidth;
      if (typeof track.scrollTo === "function") track.scrollTo({ left, behavior: "auto" });
      else track.scrollLeft = left;
    }
    dialog.close();
  };

  if (!w.__momentsReady) {
    w.__momentsReady = true;

    document.addEventListener("click", (event) => {
      const target = event.target as Element;

      const filterButton = target.closest<HTMLButtonElement>("[data-moments-filter]");
      if (filterButton) {
        const filter = filterButton.dataset.momentsFilter;
        document.querySelectorAll<HTMLButtonElement>("[data-moments-filter]").forEach((item) => {
          const selected = item === filterButton;
          item.setAttribute("aria-pressed", String(selected));
          item.className = selected ? activeClass : inactiveClass;
        });
        document.querySelectorAll<HTMLElement>("[data-moment-card]").forEach((card) => {
          card.classList.toggle("hidden", filter !== "all" && card.dataset.momentCategory !== filter);
        });
        return;
      }

      const dialog = getDialog();
      if (!dialog) return;

      const openButton = target.closest<HTMLButtonElement>("[data-moment-open]");
      if (openButton) {
        const card = openButton.closest<HTMLElement>("[data-moment-card]");
        const gallery = openButton.closest<HTMLElement>("[data-moment-gallery]");
        if (!card || !gallery) return;
        lightbox.photos = [...gallery.querySelectorAll<HTMLElement>("[data-moment-open]")].map((button) => ({
          src: button.dataset.imageSrc ?? "",
          alt: button.dataset.imageAlt ?? "",
          description: button.dataset.imageDesc ?? "",
        }));
        lightbox.track = gallery.querySelector<HTMLElement>("[data-moment-track]");
        const caption = dialog.querySelector<HTMLElement>("[data-lightbox-caption]");
        const category = dialog.querySelector<HTMLElement>("[data-lightbox-category]");
        const details = dialog.querySelector<HTMLAnchorElement>("[data-lightbox-details]");
        if (caption) caption.textContent = card.dataset.momentCaption ?? "";
        if (category) category.textContent = card.dataset.momentCategoryLabel ?? "";
        if (details) details.href = card.dataset.momentPath ?? "#";
        showPhoto(Number(openButton.dataset.index ?? 0));
        dialog.showModal();
        return;
      }

      if (target.closest("[data-lightbox-prev]")) return showPhoto(lightbox.index - 1);
      if (target.closest("[data-lightbox-next]")) return showPhoto(lightbox.index + 1);
      if (target.closest("[data-lightbox-close]") || target === dialog) closeLightbox(dialog);
    });

    document.addEventListener("keydown", (event) => {
      const dialog = getDialog();
      if (!dialog?.open) return;
      if (event.key === "ArrowLeft") showPhoto(lightbox.index - 1);
      else if (event.key === "ArrowRight") showPhoto(lightbox.index + 1);
    });

    // swipe left/right on the full-size photo
    let touchStartX = 0;
    document.addEventListener("touchstart", (event) => {
      if ((event.target as Element).closest("[data-lightbox-image]")) touchStartX = event.changedTouches[0].clientX;
    }, { passive: true });
    document.addEventListener("touchend", (event) => {
      if (!(event.target as Element).closest("[data-lightbox-image]")) return;
      const delta = event.changedTouches[0].clientX - touchStartX;
      if (Math.abs(delta) > 50) showPhoto(lightbox.index + (delta < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>
