---
import { getCollection } from "astro:content";
import { pagesData, momentsData } from "@/data/content";
import MomentMotif from "@/components/MomentMotif.astro";
import RootLayout from "@/layouts/RootLayout.astro";

const accents: Record<string, string> = {
  art: "text-rose-500/40 dark:text-rose-300/30",
  gears: "text-amber-600/40 dark:text-amber-300/30",
  city: "text-sky-500/40 dark:text-sky-300/30",
  leaf: "text-orange-500/40 dark:text-orange-300/30",
  lake: "text-cyan-600/40 dark:text-cyan-300/30",
  mountains: "text-indigo-500/40 dark:text-indigo-300/30",
};

const categories = (await getCollection("moment-categories"))
  .map(({ id, data }) => ({ id: id.replace(/\.mdx?$/, ""), data }))
  .sort((a, b) => a.data.name.localeCompare(b.data.name));
const categoryNames = new Map(categories.map(({ id, data }) => [id, data.name]));
const galleryItems = momentsData.items.map((item) => {
  const categoryLabel = categoryNames.get(item.category);
  if (!categoryLabel) {
    throw new Error(`Unknown Moments category "${item.category}" for "${item.caption}".`);
  }
  return { ...item, categoryLabel, accent: accents[item.motif] };
});
const usedCategories = categories.filter(({ id }) =>
  momentsData.items.some((item) => item.category === id),
);
---

<RootLayout title={pagesData.moments.seoTitle} description={pagesData.moments.seoDescription} wide>
  <header class="mb-6 border-b border-gray-200 pb-4 dark:border-gray-800">
    <h1 class="text-2xl font-extrabold tracking-tight text-gray-900 dark:text-gray-100">{pagesData.moments.title}</h1>
    <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600 dark:text-gray-300">
      {momentsData.intro}
    </p>
  </header>

  <nav class="mt-8 flex flex-wrap gap-2" aria-label="Filter moments by category">
    <button
      type="button"
      data-moments-filter="all"
      aria-pressed="true"
      class="rounded-full bg-primary-700 px-4 py-2 text-sm font-semibold text-white"
    >
      All
    </button>
    {usedCategories.map(({ id, data }) => (
      <button
        type="button"
        data-moments-filter={id}
        aria-pressed="false"
        class="rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800"
      >
        {data.name}
      </button>
    ))}
  </nav>

  {galleryItems.length > 0 ? (
    <ul class="mt-4 grid grid-cols-1 gap-x-8 lg:grid-cols-2">
      {galleryItems.map((item) => (
        <li data-moment-card data-moment-category={item.category} class="py-4">
          <article class="space-y-3">
            <div class="grid w-full max-w-[36rem] grid-cols-2 gap-3 sm:gap-4">
              {item.images.map((image, index) => (
                <button
                  type="button"
                  data-moment-open
                  data-image-src={image}
                  data-image-alt={item.alt || item.caption}
                  data-image-caption={item.caption}
                  data-image-category={item.categoryLabel}
                  aria-label={`View photo ${index + 1} for ${item.caption}`}
                  class:list={["group block w-full overflow-hidden rounded-lg bg-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500 focus:ring-offset-2 dark:bg-gray-800 dark:focus:ring-offset-gray-950", item.images.length === 1 && "col-span-2"]}
                >
                  <img
                    src={image}
                    alt={item.alt}
                    class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
                    loading="lazy"
                    decoding="async"
                  />
                </button>
              ))}
            </div>
            <div class="relative isolate min-h-32 max-w-[36rem] py-2">
              <MomentMotif motif={item.motif} class={item.accent} />
              <div class="relative z-10">
                <p class="text-xs font-semibold uppercase tracking-[0.16em] text-primary-700 dark:text-primary-300">{item.categoryLabel}</p>
                <h2 class="mt-2 text-xl font-bold leading-tight text-gray-900 dark:text-gray-100 sm:text-2xl">{item.caption}</h2>
                {item.writeup && <p class="mt-3 max-w-xl text-sm leading-6 text-gray-600 dark:text-gray-300">{item.writeup}</p>}
              </div>
            </div>
          </article>
        </li>
      ))}
    </ul>
  ) : (
    <p class="mt-8 py-8 text-center text-sm text-gray-600 dark:text-gray-300">
      No moments have been added yet.
    </p>
  )}

  <dialog
    id="moment-lightbox"
    aria-labelledby="moment-lightbox-caption"
    class="m-auto max-h-[92vh] w-[calc(100%-2rem)] max-w-6xl overflow-hidden rounded-2xl border border-gray-200 bg-white p-0 text-gray-900 shadow-2xl backdrop:bg-black/80 dark:border-gray-700 dark:bg-gray-900 dark:text-gray-100"
  >
    <div class="flex items-center justify-between gap-4 border-b border-gray-200 p-3 dark:border-gray-700">
      <div>
        <p data-lightbox-category class="text-xs font-semibold uppercase tracking-wide text-primary-700 dark:text-primary-300"></p>
        <h2 id="moment-lightbox-caption" data-lightbox-caption class="mt-1 text-sm font-semibold"></h2>
      </div>
      <button
        type="button"
        data-lightbox-close
        class="shrink-0 rounded-md border border-gray-300 px-3 py-1.5 text-sm font-semibold hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-primary-500 dark:border-gray-600 dark:hover:bg-gray-800"
      >
        Close
      </button>
    </div>
    <img data-lightbox-image src="" alt="" class="max-h-[82vh] w-full bg-black object-contain" />
  </dialog>
</RootLayout>

<script>
  const filterButtons = document.querySelectorAll<HTMLButtonElement>("[data-moments-filter]");
  const entries = document.querySelectorAll<HTMLElement>("[data-moment-card]");
  const activeClass = "rounded-full bg-primary-700 px-4 py-2 text-sm font-semibold text-white";
  const inactiveClass = "rounded-full border border-gray-300 px-4 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-100 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-800";

  filterButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const filter = button.dataset.momentsFilter;
      filterButtons.forEach((item) => {
        const selected = item === button;
        item.setAttribute("aria-pressed", String(selected));
        item.className = selected ? activeClass : inactiveClass;
      });
      entries.forEach((entry) => {
        entry.classList.toggle("hidden", filter !== "all" && entry.dataset.momentCategory !== filter);
      });
    });
  });

  const dialog = document.querySelector<HTMLDialogElement>("#moment-lightbox");
  const dialogImage = dialog?.querySelector<HTMLImageElement>("[data-lightbox-image]");
  const dialogCaption = dialog?.querySelector<HTMLElement>("[data-lightbox-caption]");
  const dialogCategory = dialog?.querySelector<HTMLElement>("[data-lightbox-category]");

  document.querySelectorAll<HTMLButtonElement>("[data-moment-open]").forEach((button) => {
    button.addEventListener("click", () => {
      if (!dialog || !dialogImage || !dialogCaption || !dialogCategory) return;
      dialogImage.src = button.dataset.imageSrc ?? "";
      dialogImage.alt = button.dataset.imageAlt ?? "";
      dialogCaption.textContent = button.dataset.imageCaption ?? "";
      dialogCategory.textContent = button.dataset.imageCategory ?? "";
      dialog.showModal();
    });
  });

  dialog?.querySelector<HTMLButtonElement>("[data-lightbox-close]")?.addEventListener("click", () => dialog.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
