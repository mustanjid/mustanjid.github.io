---
import RootLayout from "@/layouts/RootLayout.astro";
import SocialShare from "@/layouts/share/SocialShare.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import { getResearchEntries } from "@/functions";
import { pagesData } from "@/data/content";
import { shareImageSource } from "@/og";
import { STATUS_BADGE, STATUS_LABEL, doiUrl, paperPdfUrl } from "@/research-ui";

// One page per paper so it can be shared with its own title, image and description in the link preview.
export async function getStaticPaths() {
  const entries = await getResearchEntries();
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const t = pagesData.research;
const { entry } = Astro.props;
const { data } = entry;
const { Content } = await entry.render();
const hasNotes = entry.body.trim().length > 0;
const citation = data.citation?.trim() || [
  `${data.authors}${data.date ? ` (${data.date.getFullYear()})` : ""}.`,
  `${data.title}.`,
  data.venue,
  data.citationDetails,
].filter(Boolean).join(" ");
const pdfLink = paperPdfUrl(data.pdfUrl, data.url, data.preprintUrl);
const doiLink = doiUrl(data.doi);
const links = [
  pdfLink && { label: "PDF", href: pdfLink },
  data.url && data.url !== pdfLink && { label: "Publisher", href: data.url },
  data.preprintUrl && data.preprintUrl !== pdfLink && { label: "Preprint", href: data.preprintUrl },
  data.datasetUrl && { label: "Dataset", href: data.datasetUrl },
  data.projectUrl && { label: "Project", href: data.projectUrl },
  data.codeUrl && { label: "Code", href: data.codeUrl },
  doiLink && { label: "DOI", href: doiLink },
].filter((link): link is { label: string; href: string } => !!link);
const description = data.summary?.trim() || citation;
const btn = "inline-flex min-h-9 items-center rounded-md border border-primary-700 px-3 py-1.5 text-sm font-semibold text-primary-700 hover:bg-primary-50 dark:border-primary-300 dark:text-primary-300 dark:hover:bg-gray-800";
const meta = [data.venue, data.publisher, data.citationDetails].filter(Boolean).join(" · ");
---

<RootLayout
  title={`${data.title} | ${t.publicationsTitle}`}
  description={description}
  image={shareImageSource(data.image, data.sharePreview)}
  imageAlt={data.title}
  type="article"
  publishedTime={data.date?.toISOString()}
>
  <article class="mx-auto max-w-4xl py-8">
    <a href="/research" class="text-sm font-semibold text-primary-600 hover:underline dark:text-primary-400">&larr; {t.backLabel}</a>
    {data.image && <img src={data.image} alt="" class="mt-6 max-h-72 w-full rounded-xl bg-gray-50 object-contain p-2 dark:bg-gray-800" />}

    <header class="mt-8 border-b border-gray-200 pb-6 dark:border-gray-700">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-gray-500 dark:text-gray-400">
        <span class={`rounded px-2 py-0.5 font-semibold ${STATUS_BADGE[data.status]}`}>{STATUS_LABEL[data.status]}</span>
        {data.date && <time datetime={data.date.toISOString()}><FormattedDate date={data.date} /></time>}
      </div>
      <h1 class="mt-3 text-2xl font-extrabold leading-tight tracking-tight text-gray-900 dark:text-gray-100 sm:text-3xl">{data.title}</h1>
      <p class="mt-3 text-base text-gray-700 dark:text-gray-300">{data.authors}</p>
      {meta && <p class="mt-1 text-sm italic text-gray-500 dark:text-gray-400">{meta}</p>}
    </header>

    {data.summary && (
      <section class="prose prose-lg mt-8 max-w-none dark:prose-invert" aria-label="Summary">
        <p>{data.summary}</p>
      </section>
    )}

    {hasNotes && (
      <section class="prose prose-lg mt-6 max-w-none dark:prose-invert" aria-label="Notes">
        <Content />
      </section>
    )}

    <section class="mt-8" aria-labelledby="paper-citation">
      <h2 id="paper-citation" class="text-xl font-bold text-gray-900 dark:text-gray-100">{t.citationLabel}</h2>
      <p class="mt-2 text-sm leading-6 text-gray-700 dark:text-gray-300">{citation}</p>
    </section>

    {data.tags.length > 0 && (
      <ul class="mt-6 flex flex-wrap gap-2">
        {data.tags.map((tag) => (
          <li class="rounded-full bg-primary-50 px-3 py-1 text-sm font-medium text-primary-800 dark:bg-primary-950 dark:text-primary-200">{tag}</li>
        ))}
      </ul>
    )}

    {links.length > 0 && (
      <nav class="mt-8 flex flex-wrap gap-2" aria-label="Paper links">
        {links.map((link) => <a class={btn} href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
      </nav>
    )}

    <SocialShare title={data.title} description={description} />
  </article>
</RootLayout>
